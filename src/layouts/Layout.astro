---
import "../styles/modern.css";
import CookieBanner from "../components/CookieBanner.astro";

const {
  title = "Guiding Point Consulting",
  description = "Web + AI consulting that bridges tech, creativity, and human connection.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" href="/logo.webp" />

    <!-- Preload first slide (LCP element) -->
    <link rel="preload" as="image" href="/images/slide-1.webp" />
    <link rel="preload" as="image" href="/logo.webp" />

    <!-- Fonts: preconnect + non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- GTM: injected 2s after load on all devices, never blocks paint -->
    <script is:inline>
      (function () {
        function loadGTM() {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', 'GTM-PDKGQHB4');
        }
        window.addEventListener('load', function () {
          setTimeout(loadGTM, 2000);
        });
      })();
    </script>
  </head>

  <body>
    <!-- GTM noscript fallback -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PDKGQHB4"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <!-- Header -->
    <header class="site-header">
      <div class="container">
        <div class="header-content">
          <a href="/" class="logo-link">
            <img src="/logo.webp" alt="Guiding Point Consulting" class="logo" />
          </a>

          <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
            <span class="hamburger"></span>
          </button>

          <nav class="main-nav">
            <a href="/about">About</a>

            <div class="nav-dropdown">
              <button class="dropdown-trigger" aria-expanded="false" aria-haspopup="true">
                Services
                <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="dropdown-menu">
                <a href="/services">All Services</a>
                <a href="/services/website-modernization">Website Modernization</a>
                <a href="/services/ai-content-operations">AI Content Operations</a>
                <a href="/services/ai-team-training">AI Team Training</a>
                <a href="/services/custom-ai-chatbots">Custom AI Chatbots</a>
                <a href="/services/fractional-digital-strategy">Fractional Digital Strategy</a>
              </div>
            </div>

            <div class="nav-dropdown">
              <button class="dropdown-trigger" aria-expanded="false" aria-haspopup="true">
                Who We Serve
                <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="dropdown-menu">
                <a href="/nonprofits">Nonprofits</a>
                <a href="/government-contractors">Government Contractors</a>
              </div>
            </div>

            <a href="/case-studies">Case Studies</a>
            <a href="/capability-statement">Capability Statement</a>
            <a href="/faq">FAQ</a>
            <a href="/blog">Blog</a>
            <a href="/contact" class="nav-cta">Request a Consult</a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">

        <div class="footer-content">
          <div class="footer-brand">
            <img src="/logo.webp" alt="Guiding Point Consulting" class="footer-logo" />
            <p>Web + AI consulting that bridges tech, creativity, and human connection.</p>
          </div>

          <div class="footer-links">
            <div class="footer-col">
              <h4>Services</h4>
              <a href="/services/website-modernization">Website Modernization</a>
              <a href="/services/ai-content-operations">AI Content Operations</a>
              <a href="/services/ai-team-training">AI Team Training</a>
              <a href="/services/custom-ai-chatbots">Custom AI Chatbots</a>
              <a href="/services/fractional-digital-strategy">Fractional Digital Strategy</a>
            </div>
            <div class="footer-col">
              <h4>Company</h4>
              <a href="/about">About</a>
              <a href="/case-studies">Case Studies</a>
              <a href="/capability-statement">Capability Statement</a>
              <a href="/blog">Blog</a>
              <a href="/faq">FAQ</a>
              <a href="/contact">Contact</a>
            </div>
            <div class="footer-col">
              <h4>For Nonprofits</h4>
              <a href="/nonprofits">Nonprofit Services</a>
              <a href="/nonprofits#services">Website Modernization</a>
              <a href="/nonprofits#services">AI Content Operations</a>
              <a href="/nonprofits#services">AI Team Training</a>
              <a href="/contact">Request a Free Audit</a>
            </div>
            <div class="footer-col">
              <h4>Connect</h4>
              <a
                href="https://www.linkedin.com/company/guiding-point-consults-llc/"
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-right:8px;">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Guiding Point Consulting, LLC. All rights reserved.</p>
          <div class="footer-legal">
            <a href="/terms">Terms & Conditions</a>
            <a href="/privacy">Privacy Policy</a>
            <a href="/cookie-statement">Cookie Statement</a>
            <a href="/accessibility">Accessibility</a>
          </div>
        </div>

      </div>
    </footer>

    <!-- Cookie Banner -->
    <CookieBanner />

    <!-- Mobile menu -->
    <script>
      const menuToggle = document.querySelector('.mobile-menu-toggle');
      const mainNav = document.querySelector('.main-nav');

      if (menuToggle && mainNav) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
          menuToggle.classList.toggle('active');
          mainNav.classList.toggle('mobile-active');
          document.body.classList.toggle('menu-open');
        });

        mainNav.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menuToggle.setAttribute('aria-expanded', 'false');
            menuToggle.classList.remove('active');
            mainNav.classList.remove('mobile-active');
            document.body.classList.remove('menu-open');
          });
        });
      }

      const navDropdowns = document.querySelectorAll('.nav-dropdown');

      navDropdowns.forEach((navDropdown) => {
        const dropdownTrigger = navDropdown.querySelector('.dropdown-trigger');
        if (!dropdownTrigger) return;

        dropdownTrigger.addEventListener('click', (e) => {
          e.preventDefault();
          const isOpen = navDropdown.classList.toggle('open');
          dropdownTrigger.setAttribute('aria-expanded', isOpen.toString());

          navDropdowns.forEach((other) => {
            if (other !== navDropdown) {
              other.classList.remove('open');
              other.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
            }
          });
        });
      });

      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Node)) return;

        navDropdowns.forEach((navDropdown) => {
          if (!navDropdown.contains(target)) {
            navDropdown.classList.remove('open');
            navDropdown.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
          }
        });
      });
    </script>
  </body>
</html>