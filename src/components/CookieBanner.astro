---
// Cookie Banner Component
---

<div id="cookie-banner" class="cookie-banner" style="display: none;">
  <div class="cookie-content">
    <div class="cookie-text">
      <p>Guiding Point Consulting uses cookies to make your experience even better. Choose which cookies you're comfortable with. Details are in our <a href="/cookie-statement" class="cookie-learn-more">Cookie Statement</a>, <a href="/privacy" class="cookie-learn-more">Privacy Policy</a>, and <a href="/terms" class="cookie-learn-more">Terms of Service</a>.</p>
    </div>
    <div class="cookie-actions">
      <button id="cookie-accept" class="cookie-btn cookie-accept">Accept All</button>
      <button id="cookie-necessary" class="cookie-btn cookie-necessary">Necessary Only</button>
      <button id="cookie-decline" class="cookie-btn cookie-decline">Decline</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--rust);
    border-top: 2px solid #8b2a26;
    padding: var(--space-lg);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
    z-index: 9999;
    animation: slideUp 0.4s ease-out;
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .cookie-content {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .cookie-text {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .cookie-text p {
    margin: 0;
    font-size: 0.95rem;
    color: #ffffff;
    line-height: 1.5;
  }

  .cookie-learn-more {
    color: #ffffff;
    text-decoration: underline;
    font-size: 0.95rem;
    white-space: nowrap;
    font-weight: 600;
  }

  .cookie-learn-more:hover {
    opacity: 0.9;
  }

  .cookie-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .cookie-btn {
    padding: 0.75rem 1.5rem;
    border: 2px solid transparent;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .cookie-accept {
    background: #ffffff;
    color: var(--rust);
    border-color: #ffffff;
  }

  .cookie-accept:hover {
    background: #f5f5f5;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.3);
  }

  .cookie-necessary {
    background: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.6);
  }

  .cookie-necessary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .cookie-decline {
    background: transparent;
    color: #ffffff;
    border-color: #ffffff;
  }

  .cookie-decline:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .cookie-banner {
      padding: var(--space-md);
    }

    .cookie-content {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .cookie-text {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .cookie-text p {
      font-size: 0.875rem;
    }

    .cookie-actions {
      width: 100%;
      flex-direction: column;
    }

    .cookie-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  // Cookie banner logic
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const necessaryBtn = document.getElementById('cookie-necessary');
  const declineBtn = document.getElementById('cookie-decline');

  // Check if user has already made a choice
  const cookieConsent = localStorage.getItem('cookieConsent');

  if (!cookieConsent) {
    // Show banner if no choice has been made
    if (banner) {
      banner.style.display = 'block';
    }
  }

  function recordConsent(value: string) {
    localStorage.setItem('cookieConsent', value);
    localStorage.setItem('cookieConsentDate', new Date().toISOString());
    if (banner) {
      banner.style.display = 'none';
    }
  }

  // Accept all cookies — enables analytics/marketing (GTM)
  if (acceptBtn) {
    acceptBtn.addEventListener('click', () => {
      recordConsent('accepted');
      // Layout.astro exposes this so GTM can load immediately on consent,
      // not just on the next page load.
      if (typeof (window as any).__gpcLoadGTM === 'function') {
        (window as any).__gpcLoadGTM();
      }
    });
  }

  // Necessary only — no analytics/marketing scripts are loaded
  if (necessaryBtn) {
    necessaryBtn.addEventListener('click', () => {
      recordConsent('necessary');
    });
  }

  // Decline — same practical effect as Necessary Only (no non-essential
  // cookies), kept as a separate stored value in case you want to report
  // on decline vs. necessary-only rates later.
  if (declineBtn) {
    declineBtn.addEventListener('click', () => {
      recordConsent('declined');
    });
  }
</script>