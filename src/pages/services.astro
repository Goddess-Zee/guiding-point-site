---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Website Audits, AI Content Ops & Fractional Strategy | Guiding Point"
  description="We help mission-based nonprofits and government prime contractors modernize websites, build AI content systems, and deliver digital strategy to the communities their work serves."
>
  <!-- Page Header with Parallax -->
  <section class="page-header parallax-section">
    <div class="parallax-bg" data-speed="0.5">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
    </div>
    <div class="container hero-content">
      <h1>Services</h1>
      <p class="hero-text">Five ways to work together whether you need to diagnose what's going on, build smarter systems, train your team, add a custom AI assistant, or lead a complex digital initiative.</p>
      <p class="hero-subtext">Guiding Point serves mission-based nonprofits directly and supports government prime contractors as a trusted subcontractor delivering web, AI content ops, and digital strategy services to the clients and communities their contracts serve.</p>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="who-section">
    <div class="container">
      <h2 class="section-title">Who We Work With</h2>
      <div class="who-grid">
        <div class="who-card">
          <h3>Mission-Based Nonprofits</h3>
          <p>We work directly with nonprofit organizations that need clearer websites, smarter content systems, practical AI training, and custom chatbots designed for the realities of mission-driven work, limited capacity, and non-technical staff.</p>
        </div>
        <div class="who-card">
          <h3>Government Prime Contractors</h3>
          <p class="who-label">Subcontract Support</p>
          <p>We support government primes as a qualified subcontractor delivering web, AI content ops, team training, and digital strategy services to the public-sector clients, agencies, and communities their contracts serve. The prime stays on contract. We handle the digital and AI delivery.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="services-detail">
    <div class="container">

      <!-- Service 1 -->
      <div class="service-detail-card" id="audit">
        <div class="service-badge">01</div>
        <h2>Website Audit + Modernization Roadmap</h2>
        <p class="service-tagline">Clarity on what to fix first and why.</p>

        <div class="service-content">
          <div class="service-description">
            <h3>Who it's For</h3>
            <p>Mission-based nonprofits that need clarity on what to fix before investing in a rebuild and government primes whose contracts require web modernization, accessibility, or content improvements for the organizations or communities they serve.</p>

            <h3>What You Get</h3>
            <ul>
              <li>UX and content structure review covering clarity, navigation, and messaging.</li>
              <li>Performance and accessibility quick wins that support trust and compliance.</li>
              <li>SEO fundamentals check including metadata, indexability, and on-page issues.</li>
              <li>Conversion review covering CTAs, flow, and friction points.</li>
              <li>A prioritized roadmap from quick wins to larger upgrades with effort and impact notes your leadership and technical teams can actually use.</li>
            </ul>

            <h3>Outcome</h3>
            <p>A practical, sequenced plan you can execute with us, your internal team, or existing vendors without guessing where to start.</p>
          </div>

          <div class="service-cta">
            <a href="/contact" class="btn btn-primary">Request a Consult</a>
          </div>
        </div>
      </div>

      <!-- Service 2 -->
      <div class="service-detail-card" id="content-ops">
        <div class="service-badge">02</div>
        <h2>AI-Supported Content Operations</h2>
        <p class="service-tagline">SOPs, prompts, QA, and workflows that help real humans ship better content, faster.</p>

        <div class="service-content">
          <div class="service-description">
            <h3>Who it's For</h3>
            <p>Nonprofit communications, program, and operations staff who need repeatable, staff-friendly content workflows and government primes whose client organizations need documented AI-assisted content systems as part of a digital modernization contract.</p>

            <h3>What You Get</h3>
            <ul>
              <li>Content workflow mapping covering roles, approvals, and publishing cadence.</li>
              <li>Simple SOPs for drafting, editing, publishing, and repurposing.</li>
              <li>A prompt and template library tailored to your brand voice, audiences, and channels.</li>
              <li>QA checklist for facts, tone, accessibility, and compliance-friendly checks.</li>
              <li>Templates for briefs, outlines, and production-ready drafts.</li>
            </ul>

            <h3>Outcome</h3>
            <p>A repeatable content system that helps your team publish faster and stay aligned.</p>
          </div>

          <div class="service-cta">
            <a href="/contact" class="btn btn-primary">Build Content Ops</a>
          </div>
        </div>
      </div>

      <!-- Service 3 -->
      <div class="service-detail-card" id="ai-training">
        <div class="service-badge">03</div>
        <h2>AI Team Training</h2>
        <p class="service-tagline">Help your staff use AI safely and confidently in their day-to-day work.</p>

        <div class="service-content">
          <div class="service-description">
            <h3>Who it's For</h3>
            <p>Nonprofit teams whose staff are using AI inconsistently or not at all and government primes who need qualified subcontract support to deliver AI literacy and adoption training to the organizations their contracts serve.</p>

            <h3>What You Get</h3>
            <ul>
              <li>Plain-language training on what AI can and cannot do.</li>
              <li>Role-based examples for program, comms, development, and operations staff.</li>
              <li>Guardrails for privacy, compliance, and brand voice.</li>
              <li>Guided practice using your own content, templates, and prompt kits.</li>
              <li>Simple "when to use AI / when not to" decision points non-technical staff can follow.</li>
            </ul>

            <h3>Outcome</h3>
            <p>A team that knows how to use AI with confidence, consistency, and appropriate caution built around your actual tools and workflows.</p>
          </div>

          <div class="service-cta">
            <a href="/contact" class="btn btn-primary">Schedule a Training</a>
          </div>
        </div>
      </div>

      <!-- Service 4 -->
      <div class="service-detail-card" id="chatbots">
        <div class="service-badge">04</div>
        <h2>Custom Mission-Aware Chatbots & AI Assistants</h2>
        <p class="service-tagline">AI built from your own content, in your own voice, designed for the people you serve.</p>

        <div class="service-content">
          <div class="service-description">
            <h3>Who it's For</h3>
            <p>Nonprofits ready to give staff and visitors a faster, more accurate way to find answers and content support and government primes whose contracts include AI tool implementation or digital capacity building for client organizations.</p>

            <h3>What You Get</h3>
            <ul>
              <li>A custom AI assistant trained on your FAQs, website content, and key documents.</li>
              <li>Client and visitor-facing support for common questions without burdening staff.</li>
              <li>Internal staff support for quickly locating policies, procedures, and reference language.</li>
              <li>On-brand content starting points grounded in your actual programs and services.</li>
              <li>Full documentation so you own the configuration, prompts, and knowledge base with no vendor lock-in.</li>
            </ul>

            <h3>Outcome</h3>
            <p>A chatbot that sounds like your organization, understands your work, and reduces repetitive load on your team without feeling like a generic widget.</p>
          </div>

          <div class="service-cta">
            <a href="/contact" class="btn btn-primary">Explore a Custom Chatbot</a>
          </div>
        </div>
      </div>

      <!-- Service 5 -->
      <div class="service-detail-card" id="strategy">
        <div class="service-badge">05</div>
        <h2>Fractional Digital Strategy Lead</h2>
        <p class="service-tagline">A steady partner who keeps projects moving and conversations grounded in reality.</p>

        <div class="service-content">
          <div class="service-description">
            <h3>Who it's For</h3>
            <p>Nonprofit leaders who need ongoing senior digital guidance without adding a full-time role and government primes who need a reliable subcontract digital strategy partner to lead web, content, and AI workstreams for the organizations their contracts serve.</p>

            <h3>What You Get</h3>
            <ul>
              <li>Weekly or biweekly strategy and priority alignment.</li>
              <li>Roadmap management covering what ships next, what matters most, and what pauses.</li>
              <li>Stakeholder coordination across leadership, program and marketing, and technical and creative teams.</li>
              <li>Performance tracking and iteration loops tied to the metrics that matter to you.</li>
              <li>Guardrails for brand consistency, content quality, and responsible AI use.</li>
            </ul>

            <h3>Outcome</h3>
            <p>Momentum, clarity, and measurable progress with one point of contact who keeps people, timelines, and decisions moving.</p>
          </div>

          <div class="service-cta">
            <a href="/contact" class="btn btn-primary">Discuss a Retainer</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Not Sure CTA -->
  <section class="not-sure-section">
    <div class="container">
      <div class="not-sure-content">
        <h2>Not sure which fits or are you a prime looking for subcontract support?</h2>
        <p>Send a quick note about your project, contract, or organization and we'll recommend the best starting point. No pressure, no hard sell.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Parallax Header */
  .parallax-section {
    position: relative;
    overflow: hidden;
    min-height: auto;
    display: flex;
    align-items: center;
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .parallax-bg {
    position: absolute;
    top: -50%;
    left: 0;
    right: 0;
    bottom: -50%;
    z-index: 0;
    will-change: transform;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
    animation: float 15s ease-in-out infinite;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #ac3430 20%, #ff6b6b 40%, transparent 70%);
    top: -150px;
    left: -150px;
    z-index: 0;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #dcceaa 20%, #f5e6c8 40%, transparent 70%);
    top: 50px;
    right: -100px;
    z-index: 0;
    animation-delay: -7s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(30px, -30px) scale(1.05);
    }
    50% {
      transform: translate(-20px, 20px) scale(0.95);
    }
    75% {
      transform: translate(20px, 30px) scale(1.02);
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .page-header {
    border-bottom: 1px solid var(--gray-200);
  }

  .page-header h1 {
    margin-bottom: var(--space-lg);
  }

  .hero-text {
    max-width: 700px;
    margin: 0 auto var(--space-md);
    font-size: 1.125rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  .hero-subtext {
    max-width: 750px;
    margin: 0 auto;
    font-size: 1rem;
    color: var(--gray-500);
    line-height: 1.7;
    font-style: italic;
  }

  /* Who We Work With */
  .who-section {
    padding: var(--space-3xl) 0 var(--space-xl);
    background: var(--off-white);
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--indigo);
    text-align: center;
    margin-bottom: var(--space-xl);
    font-weight: 700;
  }

  .who-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .who-card {
    background: var(--white);
    padding: var(--space-xl);
    border-radius: 12px;
    border: 2px solid var(--gray-200);
    transition: all 0.3s ease;
  }

  .who-card:hover {
    border-color: var(--rust);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(172, 52, 48, 0.1);
  }

  .who-card h3 {
    font-size: 1.25rem;
    color: var(--indigo);
    margin-bottom: var(--space-sm);
  }

  .who-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--rust);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .who-card p {
    color: var(--gray-700);
    line-height: 1.7;
    margin-bottom: 0;
  }

  /* Services Detail */
  .services-detail {
    padding: var(--space-3xl) 0;
  }

  .service-detail-card {
    max-width: 900px;
    margin: 0 auto var(--space-3xl);
    padding: var(--space-2xl);
    background: var(--gray-50);
    border-radius: 12px;
    border: 1px solid var(--gray-200);
  }

  .service-badge {
    display: inline-block;
    background: var(--rust);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: var(--space-md);
  }

  .service-detail-card h2 {
    margin-bottom: var(--space-sm);
    font-size: 2.5rem;
  }

  .service-tagline {
    font-size: 1.25rem;
    color: var(--gray-600);
    margin-bottom: var(--space-xl);
  }

  .service-content {
    display: grid;
    gap: var(--space-xl);
  }

  .service-description h3 {
    font-size: 1.25rem;
    margin: var(--space-lg) 0 var(--space-sm);
    color: var(--indigo);
  }

  .service-description h3:first-child {
    margin-top: 0;
  }

  .service-description ul {
    list-style: none;
    padding: 0;
  }

  .service-description li {
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    position: relative;
    color: var(--gray-700);
  }

  .service-description li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--rust);
    font-weight: bold;
  }

  .service-cta {
    text-align: center;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--gray-200);
  }

  /* Not Sure Section */
  .not-sure-section {
    padding: var(--space-3xl) 0;
    background: linear-gradient(135deg, rgba(172, 52, 48, 0.05) 0%, rgba(50, 52, 90, 0.05) 100%);
  }

  .not-sure-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .not-sure-content h2 {
    margin-bottom: var(--space-md);
  }

  .not-sure-content p {
    margin-bottom: var(--space-lg);
    font-size: 1.25rem;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: 2px solid transparent;
  }

  .btn-primary {
    background: var(--rust);
    color: var(--white);
  }

  .btn-primary:hover {
    background: #8b2a26;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(172, 52, 48, 0.3);
  }

  @media (max-width: 768px) {
    .service-detail-card {
      padding: var(--space-lg);
    }

    .service-detail-card h2 {
      font-size: 2rem;
    }

    .who-grid {
      grid-template-columns: 1fr;
    }

    .gradient-orb {
      width: 300px;
      height: 300px;
    }

    .parallax-section {
      min-height: auto;
    }
  }
</style>

<script>
  // Parallax (Desktop only for performance)
  if (window.innerWidth > 768) {
    window.addEventListener('scroll', () => {
      const scrolled = window.pageYOffset;
      const parallaxBg = document.querySelector('.parallax-bg') as HTMLElement;
      
      if (parallaxBg && scrolled < window.innerHeight) {
        parallaxBg.style.transform = `translateY(${scrolled * 0.5}px)`;
      }
    });
  }
</script>