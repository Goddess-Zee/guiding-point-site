  /* ── CTA Section ─────────────────────────────── */
  .cta-section {
    padding: calc(var(--space-xl) * 2) 0;
    background: linear-gradient(135deg, var(--indigo) 0%, #01141f 100%);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    max-width: 960px;
    margin: 0 auto;
  }

  .cta-block {
    padding: var(--space-xl);
    border-radius: 12px;
    text-align: center;
  }

  .cta-block--primary {
    background: var(--rust);
  }

  .cta-block--secondary {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .cta-block h2 {
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    color: var(--white);
    margin-bottom: var(--space-md);
    line-height: 1.4;
  }

  .cta-block p {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-xl);
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }

  .btn-white {
    background: var(--white);
    color: var(--rust);
    border-color: var(--white);
  }

  .btn-white:hover {
    background: var(--off-white);
    transform: translateY(-2px);
  }

  .btn-outline-white {
    background: transparent;
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .btn-outline-white:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--white);
    transform: translateY(-2px);
  }

  /* ── Case Study Grid (boxes) ─────────────────── */
  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--space-xl);
    align-items: stretch;
  }

  .case-grid .case-study-card {
    max-width: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    border: none;
    border-radius: 14px;
    scroll-margin-top: 110px;
  }

  .case-grid .case-study-card:hover {
    transform: translateY(-4px);
  }

  /* Collapsed box: alternate the two brand colors */
  .case-grid .case-study-card:not(.is-open) {
    background: #021e33;
    box-shadow: 0 10px 30px rgba(2, 30, 51, 0.18);
  }

  .case-grid .case-study-card:nth-child(even):not(.is-open) {
    background: #751312;
    box-shadow: 0 10px 30px rgba(117, 19, 18, 0.18);
  }

  .case-grid .case-study-card:not(.is-open) .case-study-image,
  .case-grid .case-study-card:not(.is-open) .subcontractor-framing,
  .case-grid .case-study-card:not(.is-open) .case-snapshot,
  .case-grid .case-study-card:not(.is-open) .case-section p.context-impact,
  .case-grid .case-study-card:not(.is-open) .expandable-section ~ .case-section,
  .case-grid .case-study-card:not(.is-open) .capabilities-section,
  .case-grid .case-study-card:not(.is-open) .case-section h3 {
    display: none;
  }

  .case-grid .case-study-card:not(.is-open) .case-study-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-xl);
  }

  .case-grid .case-study-card:not(.is-open) .case-subtitle {
    order: -1;
    color: #f7f0e7;
    opacity: 0.85;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .case-grid .case-study-card:not(.is-open) h2 {
    color: #ffffff;
    font-size: 1.35rem;
    margin-bottom: var(--space-md);
  }

  .case-grid .case-study-card:not(.is-open) .case-section {
    margin-bottom: 0;
  }

  .case-grid .case-study-card:not(.is-open) .case-section p {
    color: rgba(247, 240, 231, 0.88);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .case-grid .case-study-card:not(.is-open) .expandable-section {
    margin: auto 0 0;
    padding-top: var(--space-lg);
  }

  .case-grid .case-study-card:not(.is-open) .expand-toggle {
    background: transparent;
    border: 2px solid rgba(247, 240, 231, 0.6);
    color: #f7f0e7;
    padding: var(--space-md) var(--space-lg);
  }

  .case-grid .case-study-card:not(.is-open) .expand-toggle:hover {
    border-color: #f7f0e7;
    background: rgba(247, 240, 231, 0.1);
  }

  .case-grid .case-study-card:not(.is-open) .toggle-icon {
    color: #f7f0e7;
  }

  /* Open box: full row, light background for easy reading */
  .case-grid .case-study-card.is-open {
    grid-column: 1 / -1;
    background: #ffffff;
    border-top: 8px solid #021e33;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
    transform: none;
  }

  .case-grid .case-study-card.is-open:nth-child(even) {
    border-top-color: #751312;
  }

  .case-grid .case-study-card.is-open .case-study-image {
    background: #021e33;
  }

  .case-grid .case-study-card.is-open:nth-child(even) .case-study-image {
    background: #751312;
  }

  @media (max-width: 1024px) {
    .case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .case-grid { grid-template-columns: 1fr; }
  }

  /* ── Case Study Animations ───────────────────── */
  /* Only hidden once JS has run, so content never depends on the script */
  .case-grid.anim-ready .case-study-card {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .case-grid.anim-ready .case-study-card.in-view {
    opacity: 1;
    transform: none;
  }

  .case-grid.anim-ready .case-study-card.in-view:not(.is-open):hover {
    transform: translateY(-4px);
    transition-delay: 0ms;
  }

  .case-grid .toggle-icon {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .case-grid .case-study-card:not(.is-open) .expand-toggle:hover .toggle-icon {
    transform: rotate(90deg) scale(1.15);
  }

  @keyframes case-open {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .case-grid .case-study-card.is-open .case-study-content > *,
  .case-grid .case-study-card.is-open .case-study-image {
    animation: case-open 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .case-grid .case-study-card.is-open .case-study-content > :nth-child(n+4) {
    animation-delay: 0.08s;
  }

  .case-grid .case-study-card.is-open .case-study-content > :nth-child(n+6) {
    animation-delay: 0.16s;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-grid.anim-ready .case-study-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .case-grid .case-study-card.is-open .case-study-content > *,
    .case-grid .case-study-card.is-open .case-study-image {
      animation: none;
    }
    .case-grid .toggle-icon { transition: none; }
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 768px) {
    .case-study-content { padding: var(--space-lg); }
    .case-study-content h2 { font-size: 1.5rem; }
    .case-study-image { padding: var(--space-lg); }
    .outcomes-grid { grid-template-columns: 1fr; }
    .cta-grid { grid-template-columns: 1fr; }
    .capabilities-list li { font-size: 0.8rem; }
  }
</style>

<script>
  // Fade case study boxes up as they scroll into view, row by row
  const caseGrid = document.querySelector('.case-grid');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (caseGrid && 'IntersectionObserver' in window && !reduceMotion) {
    const cards = Array.from(caseGrid.querySelectorAll<HTMLElement>('.case-study-card'));
    const cols = () => getComputedStyle(caseGrid).gridTemplateColumns.split(' ').length || 1;
    cards.forEach((card, i) => card.style.setProperty('--reveal-delay', `${(i % cols()) * 110}ms`));
    caseGrid.classList.add('anim-ready');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    cards.forEach((card) => io.observe(card));
  }

  document.querySelectorAll('.expand-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', (!expanded).toString());
      const content = button.nextElementSibling as HTMLElement;
      if (content) content.classList.toggle('expanded');
      const card = button.closest('.case-study-card') as HTMLElement | null;
      const label = button.querySelector('.toggle-text');
      if (label) label.textContent = expanded ? 'Read Full Case Study' : 'Close Case Study';
      if (card) {
        card.classList.toggle('is-open', !expanded);
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        card.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    });
  });
</script>