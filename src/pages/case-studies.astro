  .outcome-category ul {
    list-style: none;
    padding: 0;
  }

  .outcome-category li {
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    position: relative;
    font-size: 0.95rem;
    color: var(--gray-700);
    line-height: 1.6;
  }

  .outcome-category li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--rust);
    font-weight: bold;
  }

  .outcome-summary {
    font-weight: 600;
    color: var(--indigo);
    font-size: 1.05rem;
    padding: var(--space-lg);
    background: rgba(117, 19, 18, 0.05);
    border-radius: 8px;
    border-left: 4px solid var(--rust);
