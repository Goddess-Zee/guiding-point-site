  }

  /* ── Capabilities Section ────────────────────── */
  .capabilities-section {
    margin-top: var(--space-xl);
    padding: var(--space-xl);
    background: rgba(2, 30, 51, 0.04);
    border-radius: 8px;
    border: 1px solid rgba(2, 30, 51, 0.12);
  }

  .capabilities-section h3 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--indigo);
    margin-bottom: var(--space-md);
    font-weight: 700;
  }

  .capabilities-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .capabilities-list li {
    display: inline-block;
    background: var(--white);
    border: 1px solid rgba(2, 30, 51, 0.2);
    color: var(--indigo);
