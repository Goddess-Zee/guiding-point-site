---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Web Modernization + AI Content Strategy | Guiding Point Consulting"
  description="We help Mission Based Non-Profits & Government Primes modernize websites and streamline content operations with AI-assisted workflows, without losing the human touch. Get a free audit."
>
  <!-- Hero Section with Parallax -->
  <section class="hero parallax-section">
    <div class="parallax-bg" data-speed="0.5">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
    </div>
    
    <div class="container hero-content">
      <p class="hero-eyebrow">HUMAN-CENTERED WEB + AI CONTENT SYSTEMS</p>
      <h1 class="hero-title">
        Helping nonprofits show up clearly, work smarter, and serve their communities with confidence.
      </h1>
      <p class="hero-tagline">Bridging tech, creativity and human connection.</p>
      <p class="hero-description">
        Guiding Point Consulting partners with mission‑based nonprofits and government primes seeking subcontract support 
        to make their digital spaces clearer, more trustworthy, and easier for real people to use. We bridge the gap between technology, creativity, and human connection so your website and content systems actually support the communities, clients, and funders who rely on them.
      </p>
      <div class="hero-buttons">
        <a href="/contact" class="btn btn-primary">Request a Consult</a>
        <a href="/case-studies" class="btn btn-secondary">View Case Studies</a>
      </div>
    </div>
  </section>

  <!-- Who I Work With -->
  <section class="clients-section">
    <div class="container">
      <h2 class="section-title">Who We Work With</h2>
      <div class="clients-grid">
        <div class="client-card">
          <h3>Government Primes (Subcontract Support)</h3>
          <p>
            Prime contractors that need a trusted digital and AI partner to support government projects. We help you audit and modernize project websites, stand up AI‑supported content processes, train client teams, and document everything so stakeholders can follow it on a busy Tuesday, while you stay aligned with requirements, timelines, and contract expectations.
          </p>
        </div>
        <div class="client-card">
          <h3>Mission Based Non-Profit Teams</h3>
          <p>
            Nonprofits that need their website and digital content to clearly communicate who they serve, why it matters, and how people can take action. We help you clarify messaging, improve navigation and accessibility, and design AI‑supported workflows, SOPs, team training, and chatbots that non‑technical staff can use to work faster, with more confidence, and stay focused on the mission.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Slideshow Section -->
  <section class="slideshow-section" aria-label="Work moments slideshow">
    <div class="slideshow-track">

      <div class="slide active">
        <div class="slide-bg placeholder-1">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">In the Field</span>
          <p>Working alongside nonprofit staff to map the content workflows that actually happen day to day.</p>
        </div>
      </div>

      <div class="slide">
        <div class="slide-bg placeholder-2">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">Strategy Sessions</span>
          <p>Turning leadership goals into roadmaps teams can follow without a 40-slide deck.</p>
        </div>
      </div>

      <div class="slide">
        <div class="slide-bg placeholder-3">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">Training in Action</span>
          <p>Helping program and comms staff use AI safely and confidently in their day-to-day work.</p>
        </div>
      </div>

      <div class="slide">
        <div class="slide-bg placeholder-4">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">Community First</span>
          <p>Every system we build is designed for the real people your organization exists to serve.</p>
        </div>
      </div>

    </div>

    <button class="slide-btn slide-prev" aria-label="Previous slide">&#8592;</button>
    <button class="slide-btn slide-next" aria-label="Next slide">&#8594;</button>

    <div class="slide-dots" role="tablist">
      <button class="dot active" aria-label="Slide 1" role="tab"></button>
      <button class="dot" aria-label="Slide 2" role="tab"></button>
      <button class="dot" aria-label="Slide 3" role="tab"></button>
      <button class="dot" aria-label="Slide 4" role="tab"></button>
    </div>
  </section>

  <!-- What We Do -->
  <section class="about-section">
    <div class="container">
      <div class="about-content">
        <h2 class="section-title">What We Do</h2>
        <p class="about-lead">
          We're a web and AI consultancy that cares just as much about the humans behind the screens as the systems they use.
        </p>
        <p>
          Guiding Point Consulting helps mission-based nonprofits and government primes review and improve public‑facing sites, 
          streamline content workflows, and design AI‑assisted processes that support clarity, compliance, and trust, not just another tool on the stack.
        </p>
        <p>
          In practice, that means translating leadership and funder goals into practical steps, giving program and communications staff a clearer path to 
          publish, and helping technical teams and prime contractors implement changes without endless back‑and‑forth.
        </p>
        <p>
          Our role is part strategist, part translator, and part "let's actually get this out the door" partner for organizations doing mission‑critical work.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="services-section">
    <div class="container">
      <h2 class="section-title">Services</h2>
      
      <div class="services-grid">
        <div class="service-card">
          <div class="service-number">01</div>
          <h3>Website Audit + Modernization Roadmap</h3>
          <p class="service-tagline">If your website feels cluttered, outdated, or unclear, a focused audit and roadmap can restore trust and reduce friction.</p>
          <ul class="service-list">
            <li>UX and content structure review focused on real people trying to complete real tasks, residents, partners, prospects, internal teams.</li>
            <li>Performance and accessibility quick wins that support compliance and reduce day-to-day friction.</li>
            <li>A prioritized roadmap written in plain language, so leadership, program owners, and IT can agree on "what's next" without a 40-slide deck.</li>
          </ul>
          <a href="/services#audit" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">02</div>
          <h3>AI-Supported Content Operations</h3>
          <p class="service-tagline">Your team is already stretched. AI should make their work lighter, not more confusing.</p>
          <ul class="service-list">
            <li>Templates, SOPs, and checklists for common tasks, updates, reports, board materials, and outreach, so content moves faster with fewer bottlenecks.</li>
            <li>Prompt kits and guardrails tailored to your voice, values, and compliance needs so AI stays safe and on-brand.</li>
            <li>Simple governance covering who can use which tools, for what, and how content is reviewed before it goes live.</li>
          </ul>
          <a href="/services#content-ops" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">03</div>
          <h3>Custom Mission-Aware Chatbots & AI Assistants</h3>
          <p class="service-tagline">For organizations ready to take a step further, AI built from your own content, in your own voice.</p>
          <ul class="service-list">
            <li>Answer common questions for clients, residents, or supporters using your FAQs, website content, and key documents.</li>
            <li>Help internal staff quickly find policies, procedures, and reference language without digging through shared drives.</li>
            <li>Support content creation by suggesting accurate, on-brand starting points grounded in your actual programs and services.</li>
            <li>You own the configuration, prompts, and knowledge base, no generic widget, no vendor lock-in.</li>
          </ul>
          <a href="/services#chatbots" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">04</div>
          <h3>Fractional Digital Strategy Lead</h3>
          <p class="service-tagline">A steady partner who keeps projects moving and conversations grounded in reality.</p>
          <ul class="service-list">
            <li>Align leadership, communications, IT, and program teams around clear priorities and phased roadmaps, without adding a full-time leadership salary to your budget.</li>
            <li>Coordination across teams and vendors so decisions don't disappear into endless email threads.</li>
            <li>Light-touch reporting that shows progress and learns from what worked, without creating another reporting burden.</li>
            <li>Available as a direct engagement or as a trusted subcontractor to your prime.</li>
          </ul>
          <a href="/services#strategy" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">05</div>
          <h3>AI Team Training</h3>
          <p class="service-tagline">Help your staff use AI safely and confidently in their day-to-day work.</p>
          <ul class="service-list">
            <li>Plain-language training on what AI can and cannot do.</li>
            <li>Role-based examples for program, comms, development, and operations staff.</li>
            <li>Guardrails for privacy, compliance, and brand voice.</li>
            <li>Guided practice using your own content, templates, and prompt kits.</li>
            <li>Simple "when to use AI / when not to" decision points non-technical staff can follow.</li>
          </ul>
          <a href="/services#ai-training" class="service-link">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work Section -->
  <section class="process-section">
    <div class="container">
      <h2 class="section-title">How We Work</h2>
      <p class="section-lead">
        Strategy first. Then clean execution. Then systems your team can actually keep up with after launch.
      </p>
      
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3>Diagnose</h3>
          <p>
            We review your site and workflows, talk with the people doing the work, and surface quick wins and bigger gaps in plain language everyone can react to.
          </p>
        </div>

        <div class="process-step">
          <div class="step-number">2</div>
          <h3>Build</h3>
          <p>
            We co-design simple systems, templates, and AI workflows that feel like a relief, not another mandate from "the website folks."
          </p>
        </div>

        <div class="process-step">
          <div class="step-number">3</div>
          <h3>Lead</h3>
          <p>
            We stay close enough to help you prioritize, answer questions, and keep content shipping without burning out the same 2-3 people every time.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to untangle your content operations?</h2>
        <p>
          Let's talk about what's slowing you down and what a more sustainable content system could look like for your team.
        </p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary btn-large">Request a Consult</a>
          <a href="/about" class="btn btn-secondary btn-large">Learn More About Us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Parallax Hero ────────────────────────────── */
  .parallax-section {
    position: relative;
    overflow: hidden;
    min-height: auto;
    display: flex;
    align-items: center;
    padding: calc(var(--space-xl) * 2.5) 0 var(--space-xl);
  }

  .parallax-bg {
    position: absolute;
    top: -50%;
    left: 0;
    right: 0;
    bottom: -50%;
    z-index: 0;
    will-change: transform;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.6;
    animation: float 15s ease-in-out infinite;
  }

  .orb-1 {
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, #ac3430 20%, #ff6b6b 40%, transparent 70%);
    top: -200px;
    left: -200px;
    z-index: 0;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, #dcceaa 20%, #f5e6c8 40%, transparent 70%);
    top: 100px;
    right: -150px;
    z-index: 0;
    animation-delay: -7s;
  }

  .parallax-bg::after {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(50, 52, 90, 0.5) 20%, rgba(100, 100, 180, 0.3) 40%, transparent 70%);
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    filter: blur(120px);
    animation: float 20s ease-in-out infinite;
    animation-delay: -14s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25%       { transform: translate(30px, -30px) scale(1.05); }
    50%       { transform: translate(-20px, 20px) scale(0.95); }
    75%       { transform: translate(20px, 30px) scale(1.02); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--rust);
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(135deg, var(--rust) 0%, var(--indigo) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-md);
    animation: gradient-shift 4s ease infinite;
    background-size: 200% 200%;
  }

  @keyframes gradient-shift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: var(--rust);
    margin-bottom: var(--space-lg);
    font-style: italic;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: var(--gray-700);
    margin-bottom: var(--space-xl);
  }

  .hero-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Clients Section ──────────────────────────── */
  .clients-section {
    padding: calc(var(--space-xl) * 2) 0;
    background: var(--white);
  }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .client-card {
    background: var(--off-white);
    padding: var(--space-xl);
    border-radius: 12px;
    border: 2px solid var(--gray-200);
    transition: all 0.3s ease;
  }

  .client-card:hover {
    border-color: var(--rust);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(172, 52, 48, 0.1);
  }

  .client-card h3 {
    font-size: 1.5rem;
    color: var(--indigo);
    margin-bottom: var(--space-md);
  }

  .client-card p {
    color: var(--gray-700);
    line-height: 1.7;
  }

  /* ── Slideshow ────────────────────────────────── */
  .slideshow-section {
    position: relative;
    width: 100%;
    height: 540px;
    overflow: hidden;
    background: #1a1a2e;
  }

  .slideshow-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
    pointer-events: none;
  }

  .slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
    transition: transform 7s ease;
  }

  .slide.active .slide-bg {
    transform: scale(1);
  }

  /* Slide images */
  .placeholder-1 { background-image: url('/images/slide-1.png'); }
  .placeholder-2 { background-image: url('/images/slide-2.png'); }
  .placeholder-3 { background-image: url('/images/slide-3.png'); }
  .placeholder-4 { background-image: url('/images/slide-4.png'); }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .slide-caption {
    position: absolute;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(14px);
    text-align: center;
    color: var(--white);
    width: 100%;
    max-width: 640px;
    padding: 0 var(--space-lg);
    opacity: 0;
    transition: opacity 0.9s ease 0.5s, transform 0.9s ease 0.5s;
  }

  .slide.active .slide-caption {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .caption-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5c4c2;
    background: rgba(172, 52, 48, 0.35);
    border: 1px solid rgba(172, 52, 48, 0.55);
    padding: 0.3rem 1rem;
    border-radius: 20px;
    margin-bottom: var(--space-sm);
  }

  .slide-caption p {
    font-size: 1.2rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.93);
    margin: 0;
    font-weight: 400;
  }

  /* Prev / Next arrows */
  .slide-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--white);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .slide-btn:hover {
    background: rgba(172, 52, 48, 0.55);
    border-color: var(--rust);
  }

  .slide-prev { left: var(--space-lg); }
  .slide-next { right: var(--space-lg); }

  /* Dots */
  .slide-dots {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .dot.active {
    background: var(--rust);
    transform: scale(1.4);
  }

  /* ── About Section ────────────────────────────── */
  .about-section {
    padding: calc(var(--space-xl) * 2) 0;
    background: linear-gradient(to bottom, var(--white), var(--off-white));
  }

  .about-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .about-lead {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--indigo);
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }

  .about-content p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--gray-700);
    margin-bottom: var(--space-md);
  }

  /* ── Services Section ─────────────────────────── */
  .services-section {
    padding: calc(var(--space-xl) * 2) 0;
    background: var(--white);
  }

  .services-grid {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .service-card {
    background: var(--off-white);
    padding: var(--space-xl);
    border-radius: 12px;
    border-left: 4px solid var(--rust);
    transition: all 0.3s ease;
  }

  .service-card:hover {
    transform: translateX(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .service-number {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--rust);
    background: rgba(172, 52, 48, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    margin-bottom: var(--space-md);
  }

  .service-card h3 {
    font-size: 1.75rem;
    color: var(--indigo);
    margin-bottom: var(--space-sm);
  }

  .service-tagline {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0;
  }

  .service-list li {
    padding-left: 1.5rem;
    margin-bottom: var(--space-sm);
    position: relative;
    color: var(--gray-700);
    line-height: 1.7;
  }

  .service-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--rust);
    font-weight: 600;
  }

  .service-link {
    display: inline-block;
    margin-top: var(--space-md);
    color: var(--rust);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .service-link:hover {
    transform: translateX(4px);
  }

  /* ── Process Section ──────────────────────────── */
  .process-section {
    padding: calc(var(--space-xl) * 2) 0;
    background: linear-gradient(135deg, var(--indigo) 0%, #252742 100%);
    color: var(--white);
  }

  .process-section .section-title {
    color: var(--white);
  }

  .section-lead {
    font-size: 1.375rem;
    text-align: center;
    max-width: 700px;
    margin: var(--space-lg) auto var(--space-xl);
    line-height: 1.6;
    color: var(--white);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .process-step {
    text-align: center;
    padding: var(--space-lg);
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .process-step.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .process-step:nth-child(1).animate { transition-delay: 0.2s; }
  .process-step:nth-child(2).animate { transition-delay: 0.4s; }
  .process-step:nth-child(3).animate { transition-delay: 0.6s; }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: var(--rust);
    color: var(--white);
    border-radius: 50%;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .process-step h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
    color: var(--white);
  }

  .process-step p {
    line-height: 1.7;
    color: var(--white);
  }

  /* ── CTA Section ──────────────────────────────── */
  .cta-section {
    padding: calc(var(--space-xl) * 2) 0 var(--space-xl) 0;
    background: linear-gradient(135deg, var(--rust) 0%, #8b2a26 100%);
    color: var(--white);
    text-align: center;
  }

  .cta-content {
