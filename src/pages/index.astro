---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Clearer Websites & Smarter Systems for Nonprofits and Government Contractors | Guiding Point Consulting"
  description="Guiding Point Consulting delivers website modernization, operational workflows, and digital systems for nonprofits and the prime contractors who serve them. Based in Tampa, FL."
>

  <!-- ── HERO ─────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Website Modernization · Operational Workflows · Team Training</p>
      <h1 class="hero-title"><span class="line">Clearer Websites</span><br/><span class="line">Smarter Systems</span></h1>
      <p class="hero-sub">Built for Nonprofits and Public Sector Organizations.</p>
      <p class="hero-body">
        Guiding Point delivers website modernization, operational workflows, and team training that help your team work faster, communicate clearly, and stay organized without the overwhelm.
      </p>
      <div class="btn-group">
        <a href="/contact" class="btn btn-primary">Partner With Us</a>
        <a href="/nonprofits" class="btn btn-ghost">For Nonprofits</a>
      </div>
    </div>
  </section>

  <!-- ── WHO WE SUPPORT ────────────────────────────── -->
  <section class="section section--light">
    <div class="container">
      <p class="label">Who We Support</p>
      <div class="two-col">

        <div class="support-card">
          <div class="support-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="7" width="20" height="14" rx="2"/>
              <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
            </svg>
          </div>
          <h3>Public Sector Prime Contractors</h3>
          <p>Prime contractors who need a trusted teaming partner for website modernization and systems delivery on their contracts. We integrate into your team, close staffing gaps, meet compliance requirements, and handle the digital execution so you stay focused on leading the contract.</p>
          <a href="/capability-statement" class="text-link">View Capability Statement →</a>
        </div>

        <div class="support-card">
          <div class="support-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3>Nonprofits + Mission-Driven Organizations</h3>
          <p>Direct engagements for organizations whose websites no longer reflect who they are and whose processes live in people's heads instead of documented systems. Practical, sustainable solutions built for real staff with real capacity constraints.</p>
          <a href="/nonprofits" class="text-link">Explore Nonprofit Services →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── SLIDESHOW ─────────────────────────────────── -->
  <section class="slideshow-section" aria-label="Work moments">
    <div class="slideshow-track">
      <div class="slide active">
        <div class="slide-bg slide-img-1"><div class="slide-overlay"></div></div>
        <div class="slide-caption">
          <span class="caption-tag">In the Field</span>
          <p>Working alongside teams to map the workflows that actually happen day to day.</p>
        </div>
      </div>
      <div class="slide">
        <div class="slide-bg slide-img-2"><div class="slide-overlay"></div></div>
        <div class="slide-caption">
          <span class="caption-tag">Strategy Sessions</span>
          <p>Turning leadership goals into roadmaps teams can follow without a 40-slide deck.</p>
        </div>
      </div>
      <div class="slide">
        <div class="slide-bg slide-img-3"><div class="slide-overlay"></div></div>
        <div class="slide-caption">
          <span class="caption-tag">Training in Action</span>
          <p>Helping staff use AI safely and confidently with governance guardrails built in from the start.</p>
        </div>
      </div>
      <div class="slide">
        <div class="slide-bg slide-img-4"><div class="slide-overlay"></div></div>
        <div class="slide-caption">
          <span class="caption-tag">Community First</span>
          <p>Every system we build is designed for the real people your organization exists to serve.</p>
        </div>
      </div>
    </div>
    <button class="slide-btn slide-prev" aria-label="Previous slide">&#8592;</button>
    <button class="slide-btn slide-next" aria-label="Next slide">&#8594;</button>
    <div class="slide-dots">
      <button class="dot active" aria-label="Slide 1"></button>
      <button class="dot" aria-label="Slide 2"></button>
      <button class="dot" aria-label="Slide 3"></button>
      <button class="dot" aria-label="Slide 4"></button>
    </div>
  </section>

  <!-- ── FOR PRIME CONTRACTORS ─────────────────────── -->
  <section class="section section--white">
    <div class="container">
      <p class="label">For Public Sector Prime Contractors</p>
      <h2>We Fill the Gaps Your Team Doesn't Have Time For.</h2>
      <p class="section-lead">
        Website modernization and process delivery are often the hardest components to staff on government contracts. Finding qualified partners who understand compliance requirements, can integrate into an existing delivery team, and produce documentation that holds up, that's not easy.
      </p>
      <p class="section-body">
        Guiding Point works as a teaming partner and subcontractor, stepping in to handle the digital and systems delivery work so your prime team stays focused on contract management and client relationships.
      </p>

      <div class="four-col">
        <div class="prime-card">
          <h4>Staffing Gaps</h4>
          <p>We cover website modernization, workflow documentation, and AI process delivery, the components that are hard to staff internally without adding permanent headcount.</p>
        </div>
        <div class="prime-card">
          <h4>Teaming + Integration</h4>
          <p>We integrate into your delivery structure without friction, aligned to your scope, your timeline, and your reporting requirements. No management overhead, no competing for the prime relationship.</p>
        </div>
        <div class="prime-card">
          <h4>Compliance-Ready Documentation</h4>
          <p>Every deliverable comes fully documented and built to withstand compliance review. SOPs, training materials, and handoff packages that meet contract requirements and hold up after closeout.</p>
        </div>
        <div class="prime-card">
          <h4>Process Delivery</h4>
          <p>We handle the digital execution your contract requires accessible websites, operational workflow systems, and AI tools with governance guardrails so the organizations you serve get sustainable outcomes.</p>
        </div>
      </div>

      <div class="btn-group">
        <a href="/contact" class="btn btn-primary">Start a Conversation</a>
        <a href="/capability-statement" class="btn btn-outline">View Capability Statement</a>
      </div>
    </div>
  </section>

  <!-- ── WHAT WE DO ─────────────────────────────────── -->
  <section class="section section--light">
    <div class="container">
      <p class="label">What We Do</p>
      <h2>We Fix Outdated Websites and Build the Systems Behind Them.</h2>
      <p class="section-lead">
        Most organizations come to us because their website is outdated, confusing, or no longer reflects what they actually do. That's where we start. But what we usually find underneath is a second problem: no documented processes, no systems for getting work out the door, and everything dependent on one or two people who are already stretched thin.
      </p>
      <p class="section-body">We fix both. Starting with what visitors see, then building the internal systems that keep it working after we're gone.</p>

      <div class="services-grid">
        <div class="service-card">
          <span class="service-num">01</span>
          <h3>Website Modernization</h3>
          <p>Your website should make people trust you in the first 10 seconds. If it doesn't, we can fix that with a UX and messaging review, accessibility improvements, and a clear prioritized roadmap in plain language.</p>
          <a href="/services/website-modernization" class="text-link">Learn More →</a>
        </div>
        <div class="service-card">
          <span class="service-num">02</span>
          <h3>Operational Workflow Systems</h3>
          <p>When processes live in someone's head, everything slows down. We document, organize, and build the systems your team needs to get work out the door consistently without chasing down the one person who knows how it's done.</p>
          <a href="/services/ai-content-operations" class="text-link">Learn More →</a>
        </div>
        <div class="service-card">
          <span class="service-num">03</span>
          <h3>AI Tools and Training</h3>
          <p>Your team has heard about AI but doesn't know where to start safely. We deliver role-specific training with governance guardrails, prompt libraries, and a clear framework for who uses what, for what, and how it gets reviewed.</p>
          <a href="/services/ai-team-training" class="text-link">Learn More →</a>
        </div>
        <div class="service-card">
          <span class="service-num">04</span>
          <h3>Custom AI Assistants</h3>
          <p>An AI assistant built from your own documents, FAQs, and policies so visitors get answers fast and staff stop spending hours on questions that repeat every week. You own it. No vendor lock-in.</p>
          <a href="/services/custom-ai-chatbots" class="text-link">Learn More →</a>
        </div>
        <div class="service-card">
          <span class="service-num">05</span>
          <h3>Fractional Digital Strategy</h3>
          <p>A steady partner who keeps priorities clear and projects moving available as a direct engagement or as a subcontractor to your prime. Align leadership and operations without the overhead of a full-time hire.</p>
          <a href="/services/fractional-digital-strategy" class="text-link">Learn More →</a>
        </div>
      </div>

      <div class="centered">
        <a href="/services" class="btn btn-primary">View All Services</a>
      </div>
    </div>
  </section>

  <!-- ── FOR NONPROFITS ─────────────────────────────── -->
  <section class="section section--white">
    <div class="container">
      <div class="split">
        <div class="split-text">
          <p class="label">For Nonprofits</p>
          <h2>Your Website Is Outdated. Your Processes Are in Someone's Head. We Fix Both.</h2>
          <p>You already know your website doesn't look the way your organization feels. Maybe it hasn't been updated in years, it's hard to navigate, or it no longer reflects the work you're actually doing.</p>
          <p>The second problem is underneath it: leadership is asking for things that take weeks because no one has a clear process. New staff can't find what they need. Everyone has heard about AI, but no one knows how to use it without risking your compliance standing or your reputation.</p>
          <p>We start with your website because that's what your community sees first. Then we build the internal systems that make everything run more smoothly after we leave.</p>
          <a href="/nonprofits" class="btn btn-primary">Explore Nonprofit Services</a>
        </div>
        <div class="pain-box">
          <p class="pain-label">What We Hear Most Often</p>
          <ul class="pain-list">
            <li>"Our website hasn't been updated in three years and it shows."</li>
            <li>"Everything lives in one person's head. When they're out, we're stuck."</li>
            <li>"Leadership keeps asking for things that take weeks because we have no system."</li>
            <li>"We know we should be using AI but we have no guardrails, no governance, and no one trained to use it safely."</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW WE WORK ────────────────────────────────── -->
  <section class="section section--light">
    <div class="container">
      <p class="label">How We Work</p>
      <h2>Strategy First. Clean Execution. Systems That Last.</h2>
      <div class="three-col">
        <div class="how-step">
          <div class="step-num">1</div>
          <h3>Diagnose</h3>
          <p>We review your website and workflows, talk to the people doing the work, and surface what's broken and what's working in plain language everyone can act on. No jargon, no 40-slide deck.</p>
        </div>
        <div class="how-step">
          <div class="step-num">2</div>
          <h3>Build</h3>
          <p>We design and build websites, workflow systems, and AI tools that feel like a relief not another thing to manage. Clear, usable, and built for the humans who have to live with them.</p>
        </div>
        <div class="how-step">
          <div class="step-num">3</div>
          <h3>Sustain</h3>
          <p>Everything we deliver comes documented, trained on, and ready for your team to run without us. If it doesn't outlast our involvement, we haven't finished the job.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ TEASER ─────────────────────────────────── -->
  <section class="section section--white">
    <div class="container">
      <p class="label">Common Questions</p>
      <h2>A Few Things We're Asked Most.</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <h4>Do you replace or compete with prime contractors?</h4>
          <p>No. We work as a teaming partner and subcontractor supporting your delivery, not competing for your contract or your client relationship.</p>
        </div>
        <div class="faq-item">
          <h4>How do you work as a subcontractor?</h4>
          <p>We integrate into your existing team structure, align to your scope and timeline, and handle specific digital and systems delivery components of your contract.</p>
        </div>
        <div class="faq-item">
          <h4>Is this just website design?</h4>
          <p>No we start with the website because that's usually the most visible problem. But most engagements expand into the operational systems underneath it.</p>
        </div>
        <div class="faq-item">
          <h4>Where do most engagements start?</h4>
          <p>Usually with a website modernization assessment or a workflow audit. We find out what's broken first, then build from there.</p>
        </div>
      </div>
      <div class="centered">
        <a href="/faq" class="btn btn-outline">View All FAQs</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────── -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Explore a Partnership?</h2>
      <p>Whether you need a teaming partner for systems delivery on a government contract, or your nonprofit needs a clearer website and better internal systems let's start with a conversation and figure out the right next step together.</p>
      <div class="btn-group btn-group--center">
        <a href="/contact" class="btn btn-light">Partner With Us</a>
        <a href="/about" class="btn btn-ghost-light">Learn More About Us</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── BASE ──────────────────────────────────────── */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 0.75rem;
    display: block;
  }

  .section {
    padding: 4rem 0;
  }

  h2 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.2;
    color: var(--indigo);
    margin: 0 0 1rem;
  }

  .section--light { background: var(--off-white, #f5f3ef); }
  .section--white { background: var(--white, #fff); }

  /* Remove double padding where sections stack */
  .section + .section { padding-top: 3.5rem; }

  .section-lead {
    max-width: 780px;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--gray-700, #374151);
    margin-bottom: 1rem;
  }

  .section-body {
    max-width: 780px;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--gray-600, #4b5563);
    margin-bottom: 2.5rem;
  }

  .centered { text-align: center; margin-top: 2.5rem; }

  /* ── BUTTONS ──────────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 0.85rem 1.9rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-primary { background: var(--rust); color: #fff; border-color: var(--rust); }
  .btn-primary:hover { background: #5c0f0e; border-color: #5c0f0e; transform: translateY(-2px); }

  .btn-outline { background: transparent; color: var(--indigo); border-color: var(--indigo); }
  .btn-outline:hover { background: var(--indigo); color: #fff; }

  .btn-ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,0.4); }
  .btn-ghost:hover { border-color: #fff; background: rgba(255,255,255,0.08); }

  .btn-light { background: #fff; color: var(--indigo); border-color: #fff; }
  .btn-light:hover { background: #f0ece6; transform: translateY(-2px); }

  .btn-ghost-light { background: transparent; color: #fff; border-color: rgba(255,255,255,0.4); }
  .btn-ghost-light:hover { border-color: #fff; background: rgba(255,255,255,0.1); }

  .btn-group--center { justify-content: center; }

  /* ── HERO ──────────────────────────────────────── */
  .hero {
    background: linear-gradient(140deg, var(--indigo) 0%, #010f1a 100%);
    padding: 5rem 0 5.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    right: -5%;
    top: -20%;
    width: 550px;
    height: 550px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(117,19,18,0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero .container {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 800px;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.eyebrow {
  color: #fff;
}

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
    margin: 0 0 0.65rem;
    text-align: center;
    overflow: hidden;
  }

  .hero h1 .line {
    display: inline-block;
    opacity: 0;
    transform: translateY(100%);
    animation: lineReveal 0.8s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
  }

  .hero h1 .line:nth-child(1) { animation-delay: 0.1s; }
  .hero h1 .line:nth-child(3) { animation-delay: 0.3s; }

  @keyframes lineReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-sub {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 500;
    color: #b68748;
    margin: 0 0 1.25rem;
    line-height: 1.4;
    text-align: center;
  }

  .hero-body {
    max-width: 620px;
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.68);
    margin: 0 auto;
    text-align: center;
  }

  .btn-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    justify-content: center;
  }

  /* ── WHO WE SUPPORT ───────────────────────────── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .support-card {
    background: #fff;
    border-radius: 10px;
    padding: 2rem;
    border: 1px solid #e5ddd6;
    border-top: 4px solid var(--rust);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .support-icon { color: var(--rust); }

  .support-card h3 {
    font-size: 1.2rem;
    color: var(--indigo);
    font-weight: 700;
    line-height: 1.3;
  }

  .support-card p {
    font-size: 0.975rem;
    line-height: 1.75;
    color: #374151;
    flex: 1;
  }

  .text-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--rust);
    text-decoration: none;
    transition: color 0.2s;
    margin-top: 0.25rem;
  }

  .text-link:hover { color: var(--indigo); }

  /* ── SLIDESHOW ────────────────────────────────── */
  .slideshow-section {
    position: relative;
    width: 100%;
    height: 460px;
    overflow: hidden;
    background: #0a1520;
  }

  .slideshow-track { position: relative; width: 100%; height: 100%; }

  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s ease; pointer-events: none; }
  .slide.active { opacity: 1; pointer-events: auto; }

  .slide-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transform: scale(1.05); transition: transform 7s ease;
  }
  .slide.active .slide-bg { transform: scale(1); }

  .slide-img-1 { background-image: url('/images/slide-1.webp'); }
  .slide-img-2 { background-image: url('/images/slide-2.webp'); }
  .slide-img-3 { background-image: url('/images/slide-3.webp'); }
  .slide-img-4 { background-image: url('/images/slide-4.webp'); }

  .slide-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.65) 100%); }

  .slide-caption {
    position: absolute; bottom: 65px; left: 50%;
    transform: translateX(-50%) translateY(14px);
    text-align: center; color: #fff;
    width: 100%; max-width: 580px; padding: 0 2rem;
    opacity: 0; transition: opacity 0.9s ease 0.5s, transform 0.9s ease 0.5s;
  }
  .slide.active .slide-caption { opacity: 1; transform: translateX(-50%) translateY(0); }

  .caption-tag {
    display: inline-block;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #f5c4c2; background: rgba(117,19,18,0.35); border: 1px solid rgba(117,19,18,0.55);
    padding: 0.25rem 0.9rem; border-radius: 20px; margin-bottom: 0.6rem;
  }

  .slide-caption p { font-size: 1.1rem; line-height: 1.6; color: rgba(255,255,255,0.92); margin: 0; }

  .slide-btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
    color: #fff; width: 42px; height: 42px; border-radius: 50%;
    font-size: 0.95rem; cursor: pointer; z-index: 10;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .slide-btn:hover { background: rgba(117,19,18,0.5); border-color: var(--rust); }
  .slide-prev { left: 1.5rem; }
  .slide-next { right: 1.5rem; }

  .slide-dots {
    position: absolute; bottom: 1.25rem; left: 50%; transform: translateX(-50%);
    display: flex; gap: 10px; z-index: 10;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.3); border: none; cursor: pointer; padding: 0; transition: background 0.3s, transform 0.3s; }
  .dot.active { background: var(--rust); transform: scale(1.4); }

  /* ── PRIME CONTRACTORS ────────────────────────── */
  .four-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .prime-card {
    background: var(--off-white, #f5f3ef);
    border-radius: 10px;
    padding: 1.75rem;
    border: 1px solid #e5ddd6;
    border-left: 4px solid var(--rust);
  }

  .prime-card h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--indigo);
    margin-bottom: 0.6rem;
  }

  .prime-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #4b5563;
  }

  /* ── SERVICES ─────────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 0;
  }

  .service-card {
    background: #fff;
    border-radius: 10px;
    padding: 1.75rem;
    border: 1px solid #e5ddd6;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .service-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(2,30,51,0.07); }

