---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Web Modernization + AI Systems for Public Sector & Nonprofits | Guiding Point Consulting"
  description="Guiding Point Consulting modernizes websites and builds AI content systems for public sector prime contractors and mission-driven nonprofits. Human-centered digital strategy that keeps people at the center of it."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-content">
      <p class="hero-eyebrow">HUMAN-CENTERED WEB + AI CONTENT SYSTEMS</p>
      <h1 class="hero-title">
        AI is getting smarter. We build the systems that keep people at the center of it.
      </h1>
      <p class="hero-tagline">Bridging tech, creativity, and human connection.</p>
      <p class="hero-description">
        Guiding Point Consulting partners with public sector prime contractors and mission-driven nonprofits to modernize websites, build sustainable AI content workflows, and train the teams who'll run them, without losing what makes your organization human.
      </p>
      <p class="hero-clarity">
        Technology should bring people closer, not replace the connection between them.
      </p>
      <div class="hero-buttons">
        <a href="/contact" class="btn btn-primary">Partner With Us</a>
        <a href="/nonprofits" class="btn btn-secondary">For Nonprofits</a>
      </div>
    </div>
  </section>

  <!-- Who We Support -->
  <section class="clients-section">
    <div class="container">
      <h2 class="section-title">Who We Support</h2>
      <div class="clients-grid">
        <div class="client-card client-card--primary">
          <div class="client-card-badge">Primary Audience</div>
          <h3>Public Sector Prime Contractors</h3>
          <p>
            Prime contractors who need a trusted delivery partner for the digital and AI components of their contracts. We integrate into your team to handle website modernization, AI workflows, and content systems for the organizations you serve, so you meet requirements without adding internal strain.
          </p>
        </div>
        <div class="client-card">
          <div class="client-card-badge client-card-badge--secondary">Direct Engagements</div>
          <h3>Nonprofits + Mission-Driven Organizations</h3>
          <p>
            Direct engagements for organizations that need clearer websites, smarter content systems, and practical AI tools, built for real staff with real capacity constraints, not theoretical best practices. <a href="/nonprofits" class="inline-link">See how we help nonprofits →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Slideshow Section -->
  <section class="slideshow-section" aria-label="Work moments slideshow">
    <div class="slideshow-track">

      <div class="slide active">
        <div class="slide-bg placeholder-1">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">In the Field</span>
          <p>Working alongside nonprofit staff to map the content workflows that actually happen day to day.</p>
        </div>
      </div>

      <div class="slide">
        <div class="slide-bg placeholder-2">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">Strategy Sessions</span>
          <p>Turning leadership goals into roadmaps teams can follow without a 40-slide deck.</p>
        </div>
      </div>

      <div class="slide">
        <div class="slide-bg placeholder-3">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">Training in Action</span>
          <p>Helping program and comms staff use AI safely and confidently in their day-to-day work.</p>
        </div>
      </div>

      <div class="slide">
        <div class="slide-bg placeholder-4">
          <div class="slide-overlay"></div>
        </div>
        <div class="slide-caption">
          <span class="caption-tag">Community First</span>
          <p>Every system we build is designed for the real people your organization exists to serve.</p>
        </div>
      </div>

    </div>

    <button class="slide-btn slide-prev" aria-label="Previous slide">&#8592;</button>
    <button class="slide-btn slide-next" aria-label="Next slide">&#8594;</button>

    <div class="slide-dots" role="tablist">
      <button class="dot active" aria-label="Slide 1" role="tab"></button>
      <button class="dot" aria-label="Slide 2" role="tab"></button>
      <button class="dot" aria-label="Slide 3" role="tab"></button>
      <button class="dot" aria-label="Slide 4" role="tab"></button>
    </div>
  </section>

  <!-- For Public Sector Prime Contractors -->
  <section class="govcon-section">
    <div class="container">
      <h2 class="section-title section-title--light">For Public Sector Prime Contractors</h2>
      <p class="section-lead">
        We partner with prime contractors who need specialized support delivering digital systems, AI workflows, and content solutions to the communities and agencies they serve.
      </p>

      <div class="govcon-grid">
        <div class="govcon-block">
          <h3>Who We Work With</h3>
          <p>
            Prime contractors who need a trusted digital and AI partner to handle delivery components that are difficult to staff internally. We integrate into your team and stay out of the way of everything else.
          </p>
        </div>
        <div class="govcon-block">
          <h3>How We Fit In</h3>
          <p>
            Guiding Point integrates into your delivery team as a subcontractor, providing targeted expertise in areas that are often underserved: website modernization, AI content workflows, and digital communication systems built around the humans who use them.
          </p>
        </div>
        <div class="govcon-block">
          <h3>What We Help You Do</h3>
          <ul class="govcon-list">
            <li>Strengthen contract delivery</li>
            <li>Fill capability gaps in digital and AI</li>
            <li>Reduce internal workload on client-facing systems</li>
            <li>Improve outcomes for the organizations you serve</li>
          </ul>
        </div>
      </div>

      <div class="govcon-cta">
        <a href="/contact" class="btn btn-rust">Start a Conversation</a>
        <a href="/capability-statement" class="btn btn-outline-light">View Capability Statement</a>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="about-section">
    <div class="container">
      <div class="about-content">
        <h2 class="section-title">What We Do</h2>
        <p class="about-lead">
          We support public sector prime contractors and nonprofits by modernizing digital presence and building the AI content systems and workflows that sustain them.
        </p>
        <p>
          Guiding Point Consulting helps organizations strengthen delivery by improving public-facing websites, streamlining content workflows, and implementing AI-supported processes that support clarity, connection, and trust. Our work focuses on making systems usable for real teams, because the most sophisticated solution is worthless if the people inside the organization can't run it.
        </p>
        <p>
          Our role is part strategist, part translator, and part execution partner, helping teams turn complex requirements into practical systems that keep the human experience at the center.
        </p>
        <p class="about-note">
          Most engagements begin with a website and messaging audit to identify opportunities for clarity, usability, and system improvement.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="services-section">
    <div class="container">
      <h2 class="section-title">Services</h2>
      
      <div class="services-grid">
        <div class="service-card">
          <div class="service-number">01</div>
          <h3>Website Audit + Modernization Roadmap</h3>
          <p class="service-tagline">If your website feels cluttered, outdated, or unclear, a focused audit and roadmap can restore trust and reduce friction.</p>
          <ul class="service-list">
            <li>UX and content structure review focused on real people trying to complete real tasks: residents, partners, prospects, and internal teams.</li>
            <li>Performance and accessibility quick wins that support compliance and reduce day-to-day friction.</li>
            <li>A prioritized roadmap written in plain language, so leadership, program owners, and IT can agree on next steps without a 40-slide deck.</li>
          </ul>
          <a href="/services#audit" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">02</div>
          <h3>AI-Supported Content Operations</h3>
          <p class="service-tagline">Your team is already stretched. AI should make their work lighter, not replace the human judgment behind it.</p>
          <ul class="service-list">
            <li>Templates, SOPs, and checklists for common tasks: updates, reports, board materials, and outreach, so content moves faster with fewer bottlenecks.</li>
            <li>Prompt kits and guardrails tailored to your voice, values, and compliance needs so AI stays safe and on-brand.</li>
            <li>Simple governance covering who can use which tools, for what, and how content is reviewed before it goes live.</li>
          </ul>
          <a href="/services#content-ops" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">03</div>
          <h3>Custom Mission-Aware Chatbots and AI Assistants</h3>
          <p class="service-tagline">For organizations ready to take a step further: AI built from your own content, in your own voice.</p>
          <ul class="service-list">
            <li>Answer common questions for clients, residents, or supporters using your FAQs, website content, and key documents.</li>
            <li>Help internal staff quickly find policies, procedures, and reference language without digging through shared drives.</li>
            <li>Support content creation by suggesting accurate, on-brand starting points grounded in your actual programs and services.</li>
            <li>You own the configuration, prompts, and knowledge base. No generic widget, no vendor lock-in.</li>
          </ul>
          <a href="/services#chatbots" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">04</div>
          <h3>Fractional Digital Strategy Lead</h3>
          <p class="service-tagline">A steady partner who keeps projects moving and conversations grounded in reality.</p>
          <ul class="service-list">
            <li>Align leadership, communications, IT, and program teams around clear priorities and phased roadmaps, without adding a full-time leadership salary.</li>
            <li>Coordination across teams and vendors so decisions don't disappear into endless email threads.</li>
            <li>Light-touch reporting that shows progress without creating another reporting burden.</li>
            <li>Available as a direct engagement or as a trusted subcontractor to your prime.</li>
          </ul>
          <a href="/services#strategy" class="service-link">Learn more →</a>
        </div>

        <div class="service-card">
          <div class="service-number">05</div>
          <h3>AI Team Training</h3>
          <p class="service-tagline">Help your staff use AI safely and confidently, without losing the human judgment that makes their work matter.</p>
          <ul class="service-list">
            <li>Plain-language training on what AI can and cannot do.</li>
            <li>Role-based examples for program, comms, development, and operations staff.</li>
            <li>Guardrails for privacy, compliance, and brand voice.</li>
            <li>Guided practice using your own content, templates, and prompt kits.</li>
            <li>Simple decision points for when to use AI and when not to, written so non-technical staff can follow them.</li>
          </ul>
          <a href="/services#ai-training" class="service-link">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work Section -->
  <section class="process-section">
    <div class="container">
      <h2 class="section-title">How We Work</h2>
      <p class="section-lead">
        Strategy first. Then clean execution. Then systems your team can actually keep up with after launch.
      </p>
      
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3>Diagnose</h3>
          <p>
            We review your site and workflows, talk with the people doing the work, and surface quick wins and bigger gaps in plain language everyone can react to.
          </p>
        </div>

        <div class="process-step">
          <div class="step-number">2</div>
          <h3>Build</h3>
          <p>
            We co-design simple systems, templates, and AI workflows that feel like a relief, not another mandate from the website folks.
          </p>
        </div>

        <div class="process-step">
          <div class="step-number">3</div>
          <h3>Lead</h3>
          <p>
            We stay close enough to help you prioritize, answer questions, and keep content shipping without burning out the same two or three people every time.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Teaser -->
  <section class="faq-teaser-section">
    <div class="container">
      <h2 class="section-title">Common Questions</h2>
      <p class="faq-teaser-lead">A few things primes and organizations ask us most often.</p>
      <div class="faq-teaser-grid">

        <details class="faq-item">
          <summary class="faq-question">Do you replace or compete with prime contractors?</summary>
          <p class="faq-answer">No. We integrate into prime-led teams as a specialized subcontractor, supporting delivery in areas such as website modernization, content workflows, and AI implementation. Our role is to strengthen your delivery, not compete with it.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How do you work as a subcontractor?</summary>
          <p class="faq-answer">We plug into existing contract teams to deliver specific components of work that are often underserved or difficult to staff internally. We align with your scope, timelines, and reporting structure.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Is this just website design?</summary>
          <p class="faq-answer">No. We modernize websites by improving messaging, structure, usability, and internal workflows while also optimizing for AI-driven discovery through AEO and GEO. The result is a website that is functional, discoverable, and sustainable for your team.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Where do most engagements start?</summary>
          <p class="faq-answer">Most engagements begin with a website and messaging audit. This helps identify clarity issues, content gaps, and opportunities for AI integration. From there, we develop a roadmap and support implementation.</p>
        </details>

      </div>
      <div class="faq-teaser-link">
        <a href="/faq" class="btn btn-outline-indigo">View All FAQs →</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to explore a partnership?</h2>
        <p>
          Let's talk about what you're delivering and how we can support it. Whether you need targeted execution help, a longer-term digital systems partner, or a direct engagement for your nonprofit, we'll keep it practical from day one.
        </p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary btn-large">Partner With Us</a>
          <a href="/about" class="btn btn-secondary btn-large">Learn More About Us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────── */
  .hero {
    background: var(--white);
    padding: calc(var(--space-xl) * 2.5) 0 var(--space-xl);
  }

  .hero-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--rust);
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(135deg, var(--rust) 0%, var(--indigo) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-md);
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: var(--rust);
    margin-bottom: var(--space-lg);
    font-style: italic;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: var(--gray-700);
    margin-bottom: var(--space-md);
  }

  .hero-clarity {
    font-size: 1rem;
    font-weight: 600;
    color: var(--indigo);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-xl);
    padding: var(--space-sm) var(--space-lg);
    background: rgba(50, 52, 90, 0.06);
    border-left: 3px solid var(--rust);
    border-radius: 0 6px 6px 0;
    display: inline-block;
    text-align: left;
  }

  .hero-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Clients Section ──────────────────────────── */
  .clients-section {
    padding: calc(var(--space-xl) * 2) 0;
    background: var(--white);
  }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .client-card {
    background: var(--off-white);
    padding: var(--space-xl);
    border-radius: 12px;
    border: 2px solid var(--gray-200);
    transition: all 0.3s ease;
    position: relative;
  }

  .client-card--primary {
    border-color: var(--rust);
    background: rgba(172, 52, 48, 0.04);
  }

  .client-card:hover {
    border-color: var(--rust);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(172, 52, 48, 0.1);
  }

  .client-card-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rust);
    background: rgba(172, 52, 48, 0.1);
    padding: 0.2rem 0.75rem;
    border-radius: 20px;
    margin-bottom: var(--space-sm);
  }

  .client-card-badge--secondary {
    color: var(--indigo);
    background: rgba(50, 52, 90, 0.08);
  }

  .client-card h3 {
    font-size: 1.5rem;
    color: var(--indigo);
    margin-bottom: var(--space-md);
  }

  .client-card p {
    color: var(--gray-700);
    line-height: 1.7;
  }

  .inline-link {
    color: var(--rust);
    font-weight: 600;
    text-decoration: none;
  }
  .inline-link:hover {
    text-decoration: underline;
  }

  /* ── Slideshow ────────────────────────────────── */
  .slideshow-section {
    position: relative;
    width: 100%;
    height: 540px;
    overflow: hidden;
    background: #1a1a2e;
  }

  .slideshow-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
    pointer-events: none;
  }

  .slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
    transition: transform 7s ease;
  }

  .slide.active .slide-bg {
    transform: scale(1);
  }

  .placeholder-1 { background-image: url('/images/slide-1.webp'); }
  .placeholder-2 { background-image: url('/images/slide-2.webp'); }
  .placeholder-3 { background-image: url('/images/slide-3.webp'); }
  .placeholder-4 { background-image: url('/images/slide-4.webp'); }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .slide-caption {
    position: absolute;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(14px);
    text-align: center;
    color: var(--white);
    width: 100%;
    max-width: 640px;
    padding: 0 var(--space-lg);
    opacity: 0;
    transition: opacity 0.9s ease 0.5s, transform 0.9s ease 0.5s;
  }

  .slide.active .slide-caption {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .caption-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5c4c2;
    background: rgba(172, 52, 48, 0.35);
    border: 1px solid rgba(172, 52, 48, 0.55);
    padding: 0.3rem 1rem;
    border-radius: 20px;
    margin-bottom: var(--space-sm);
  }

  .slide-caption p {
    font-size: 1.2rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.93);
    margin: 0;
    font-weight: 400;
  }

  .slide-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--white);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .slide-btn:hover {
    background: rgba(172, 52, 48, 0.55);
    border-color: var(--rust);
  }

  .slide-prev { left: var(--space-lg); }
  .slide-next { right: var(--space-lg); }

  .slide-dots {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .dot.active {
    background: var(--rust);
    transform: scale(1.4);
  }

  /* ── GovCon Section ───────────────────────────── */
  .govcon-section {
    padding: calc(var(--space-xl) * 2) 0;
    background: linear-gradient(135deg, var(--indigo) 0%, #252742 100%);
    color: var(--white);
  }

  .govcon-section .section-title--light {
    color: var(--white);
  }

  .govcon-section .section-lead {
    color: rgba(255, 255, 255, 0.85);
    max-width: 700px;
    margin: var(--space-md) auto var(--space-xl);
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .govcon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .govcon-block {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: var(--space-xl);
  }

  .govcon-block h3 {
    font-size: 1.25rem;
    color: var(--white);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .govcon-block p {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
  }

  .govcon-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .govcon-list li {
    color: rgba(255, 255, 255, 0.8);
    padding-left: 1.5rem;
    margin-bottom: var(--space-sm);
    position: relative;
    line-height: 1.6;
  }

  .govcon-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: #f5c4c2;
    font-weight: 600;
  }

  .govcon-cta {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-rust {
    background: var(--rust);
    color: var(--white);
    padding: 0.875rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 2px solid var(--rust);
  }

  .btn-rust:hover {
    background: #8b2a26;
    border-color: #8b2a26;
    transform: translateY(-2px);
  }

  .btn-outline-light {
    background: transparent;
    color: var(--white);
    border: 2px solid rgba(255, 255, 255, 0.5);
    padding: 0.875rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-outline-light:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--white);
