---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Guiding Point Consulting | Partner With Us"
  description="Public sector prime contractors and mission-driven nonprofits can reach out to explore subcontract partnerships, website modernization, AI content systems, and digital strategy support. AI is getting smarter — we build the systems that keep people at the center of it."
>
  <!-- Hero -->
  <section class="contact-hero">
    <div class="container hero-content">
      <h1>Partner With Guiding Point Consulting</h1>
      <p class="hero-text">
        Guiding Point Consulting partners with public sector prime contractors as a subcontractor, supporting the delivery of website modernization, digital systems, and AI-enabled workflows for public sector and mission-driven organizations.
      </p>
      <p class="hero-sub">
        If you are looking for a specialized partner to strengthen contract delivery, improve digital communication, or implement sustainable content systems, we would be glad to connect.
      </p>
    </div>
  </section>

  <!-- Who This Is For -->
  <section class="who-section">
    <div class="container">
      <div class="who-grid">
        <div class="who-block who-block--fit">
          <h3>Who Should Reach Out</h3>
          <ul>
            <li>Government prime contractors seeking subcontract support</li>
            <li>Organizations managing digital modernization or communication projects</li>
            <li>Teams needing structured workflows, AI integration, or website improvements</li>
            <li>Leaders looking for a fractional digital strategy partner</li>
          </ul>
        </div>
        <div class="who-block who-block--notfit">
          <h3>This May Not Be the Right Fit If</h3>
          <ul>
            <li>You are only looking for a basic website design with no systems work</li>
            <li>You need a quick, low-cost project without long-term sustainability</li>
            <li>You are not interested in improving internal workflows or processes</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        
        <!-- Contact Form -->
        <div class="contact-form-wrapper">
          <h2 class="form-heading">Start a Partnership Conversation</h2>
          <form class="contact-form" name="main-contact" method="POST" data-netlify="true" data-netlify-recaptcha="true" netlify-honeypot="bot-field" action="/thanks">
            <input type="hidden" name="form-name" value="main-contact" />
            <p class="hidden">
              <label>
                Don't fill this out if you're human: <input name="bot-field" />
              </label>
            </p>

            <div class="form-row">
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required />
              </div>

              <div class="form-group">
                <label for="role">Role / Title</label>
                <input type="text" id="role" name="role" placeholder="e.g. Program Manager, Director of IT" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required />
              </div>

              <div class="form-group">
                <label for="company">Organization *</label>
                <input type="text" id="company" name="company" required />
              </div>
            </div>

            <div class="form-group">
              <label for="inquiry-type">What best describes your inquiry? *</label>
              <select id="inquiry-type" name="inquiry-type" required>
                <option value="">Select one...</option>
                <option value="govcon-subcontract">Government prime contractor — subcontract partnership</option>
                <option value="public-sector-nonprofit">Public sector or nonprofit organization</option>
                <option value="ai-training">AI training inquiry</option>
                <option value="workshop-speaking">Workshop or speaking request</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="website">Website URL</label>
              <input type="url" id="website" name="website" placeholder="https://" />
            </div>

            <div class="form-group">
              <label for="message">Briefly describe your project or need *</label>
              <textarea id="message" name="message" rows="6" required placeholder="Include any relevant contract details, project goals, timeline, or specific challenges you are facing..."></textarea>
              <p class="form-helper">For subcontracting opportunities, please include any relevant contract or project details.</p>
            </div>

            <div data-netlify-recaptcha="true"></div>

            <button type="submit" class="btn btn-primary btn-full">Submit Inquiry</button>
          </form>

          <p class="response-time">We respond to all inquiries within 1 to 2 business days.</p>
        </div>

        <!-- Contact Info -->
        <div class="contact-info">
          <div class="info-card call-form-card" id="quick-call">
            <button class="call-form-toggle" aria-expanded="false" type="button">
              <div class="toggle-header">
                <h3>Prefer a quick call?</h3>
                <span class="toggle-icon">+</span>
              </div>
              <p class="card-intro">Leave your details and we will reach out to schedule a time.</p>
            </button>
            
            <div class="call-form-content">
              <form class="quick-call-form" name="quick-call" method="POST" data-netlify="true" netlify-honeypot="bot-field-call" action="/thanks">
                <input type="hidden" name="form-name" value="quick-call" />
                <p class="hidden">
                  <label>
                    Don't fill this out: <input name="bot-field-call" />
                  </label>
                </p>

                <div class="form-group-small">
                  <label for="call-name">Name *</label>
                  <input type="text" id="call-name" name="call-name" required />
                </div>

                <div class="form-group-small">
                  <label for="call-email">Email *</label>
                  <input type="email" id="call-email" name="call-email" required />
                </div>

                <div class="form-group-small">
                  <label for="call-phone">Phone Number *</label>
                  <input type="tel" id="call-phone" name="call-phone" required />
                </div>

                <div class="form-group-small">
                  <label for="call-company">Organization</label>
                  <input type="text" id="call-company" name="call-company" />
                </div>

                <div class="form-group-small">
                  <label for="call-website">Website</label>
                  <input type="url" id="call-website" name="call-website" placeholder="https://" />
                </div>

                <button type="submit" class="btn btn-secondary btn-small-full">Request a Call</button>
              </form>
            </div>
          </div>

          <div class="info-card">
            <h3>Email</h3>
            <p><a href="mailto:hello@guidingpointconsults.com" class="contact-link">hello@guidingpointconsults.com</a></p>
          </div>

          <div class="info-card">
            <h3>Based in</h3>
            <p>Tampa, Florida</p>
            <p class="small-text">Working with clients nationwide</p>
          </div>

          <div class="info-card positioning-card">
            <p>Guiding Point Consulting supports government prime contractors as a subcontractor, delivering digital systems, AI workflows, and communication solutions to the organizations they serve.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ───────────────────────────────────── */
  .contact-hero {
    background: var(--white);
    padding: var(--space-2xl) 0 var(--space-xl);
    border-bottom: 1px solid var(--gray-200);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .contact-hero h1 {
    margin-bottom: var(--space-lg);
  }

  .hero-text {
    max-width: 800px;
    margin: 0 auto var(--space-md);
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--gray-700);
  }

  .hero-sub {
    max-width: 700px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--gray-600);
    font-style: italic;
  }

  /* ── Who Section ─────────────────────────────── */
  .who-section {
    background: var(--white);
    border-bottom: 1px solid var(--gray-200);
    padding: var(--space-xl) 0;
  }

  .who-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .who-block {
    padding: var(--space-lg);
    border-radius: 8px;
  }

  .who-block--fit {
    background: rgba(2, 30, 51, 0.04);
    border: 1px solid rgba(2, 30, 51, 0.1);
  }

  .who-block--notfit {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
  }

  .who-block h3 {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-md);
  }

  .who-block--fit h3 { color: var(--indigo); }
  .who-block--notfit h3 { color: var(--gray-600); }

  .who-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .who-block li {
    padding-left: 1.5rem;
    margin-bottom: var(--space-sm);
    position: relative;
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--gray-700);
  }

  .who-block--fit li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--rust);
    font-weight: 700;
  }

  .who-block--notfit li::before {
    content: '✕';
    position: absolute;
    left: 0;
    color: var(--gray-500);
    font-weight: 600;
  }

  /* ── Contact Section ─────────────────────────── */
  .contact-section {
    padding: var(--space-3xl) 0;
    background: var(--off-white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-3xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Form ────────────────────────────────────── */
  .contact-form-wrapper {
    background: white;
    padding: var(--space-2xl);
    border-radius: 12px;
    border: 1px solid var(--gray-200);
  }

  .form-heading {
    font-size: 1.5rem;
    color: var(--indigo);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--rust);
    display: inline-block;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-weight: 600;
    color: var(--indigo);
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.875rem;
    border: 1px solid var(--gray-300);
    border-radius: 6px;
    font-size: 1rem;
    font-family: var(--font-main);
    transition: border-color 0.2s ease;
    background: white;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--rust);
    box-shadow: 0 0 0 3px rgba(117, 19, 18, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-helper {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--gray-600);
    font-style: italic;
  }

  .btn-full { width: 100%; }

  [data-netlify-recaptcha="true"] {
    margin: var(--space-md) 0 var(--space-lg);
    display: block !important;
  }

  .hidden { display: none; }

  .response-time {
    margin-top: var(--space-lg);
    text-align: center;
    color: var(--gray-600);
    font-size: 0.875rem;
    font-style: italic;
  }

  /* ── Contact Info Sidebar ────────────────────── */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .info-card {
    background: var(--gray-50);
    padding: var(--space-lg);
    border-radius: 12px;
    border: 1px solid var(--gray-200);
  }

  .info-card.call-form-card {
    background: white;
    border: 2px solid var(--rust);
  }

  .positioning-card {
    background: rgba(2, 30, 51, 0.04);
    border: 1px solid rgba(2, 30, 51, 0.12);
  }

  .positioning-card p {
    font-size: 0.9rem;
    color: var(--gray-600);
    line-height: 1.7;
    font-style: italic;
    margin: 0;
  }

  .call-form-toggle {
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
  }

  .toggle-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .toggle-icon {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--rust);
    transition: transform 0.3s ease;
  }

  .call-form-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(45deg);
  }

  .call-form-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease;
  }

  .call-form-content.expanded {
    max-height: 800px;
    margin-top: var(--space-md);
  }

  .info-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    color: var(--indigo);
  }

  .info-card p {
    color: var(--gray-700);
    margin-bottom: var(--space-md);
  }

  .info-card p:last-child { margin-bottom: 0; }

  .card-intro { margin-bottom: var(--space-lg) !important; }

  /* ── Quick Call Form ─────────────────────────── */
  .quick-call-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group-small {
    display: flex;
    flex-direction: column;
  }

  .form-group-small label {
    font-weight: 600;
    color: var(--indigo);
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  .form-group-small input {
    padding: 0.75rem;
    border: 1px solid var(--gray-300);
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: var(--font-main);
    transition: border-color 0.2s ease;
  }

  .form-group-small input:focus {
    outline: none;
    border-color: var(--rust);
    box-shadow: 0 0 0 3px rgba(117, 19, 18, 0.1);
  }

  .btn-small-full {
    width: 100%;
    padding: 0.875rem 1.5rem;
  }

  .small-text {
    font-size: 0.875rem;
    color: var(--gray-600);
  }

  .contact-link {
    color: var(--rust);
    font-weight: 600;
  }

  .contact-link:hover { text-decoration: underline; }

  /* ── Buttons ─────────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: 2px solid transparent;
    font-size: 1rem;
    font-family: var(--font-main);
  }

  .btn-primary {
    background: var(--rust);
    color: var(--white);
    border-color: var(--rust);
  }

  .btn-primary:hover {
    background: #5a0e0d;
    border-color: #5a0e0d;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(117, 19, 18, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: var(--rust);
    border-color: var(--rust);
  }

  .btn-secondary:hover {
    background: var(--rust);
    color: var(--white);
    transform: translateY(-2px);
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 968px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .contact-form-wrapper { padding: var(--space-lg); }
  }

  @media (max-width: 768px) {
    .who-grid { grid-template-columns: 1fr; }

    .form-row { grid-template-columns: 1fr; }

    * { box-sizing: border-box !important; }
    body { overflow-x: hidden !important; }

    .container {
      padding-left: var(--space-md) !important;
      padding-right: var(--space-md) !important;
      max-width: 100% !important;
      overflow-x: hidden !important;
    }

    .contact-section {
      padding: var(--space-2xl) 0 !important;
      overflow-x: hidden !important;
    }

    .contact-grid {
      grid-template-columns: 1fr !important;
      gap: var(--space-xl) !important;
      padding: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
      overflow-x: hidden !important;
    }

    .contact-form-wrapper {
      padding: var(--space-md) !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      overflow-x: hidden !important;
    }

    .contact-form,
    .form-group,
    .form-row {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
    }

    .form-row { grid-template-columns: 1fr !important; }

    .form-group label { display: block !important; width: 100% !important; }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
      margin: 0 !important;
    }

    select {
      -webkit-appearance: none !important;
      appearance: none !important;
    }

    [data-netlify-recaptcha="true"] {
      width: 100% !important;
      max-width: 100% !important;
      overflow-x: hidden !important;
    }

    .btn-full {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }

    .contact-info,
    .info-card,
    .call-form-card {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }

    .quick-call-form,
    .form-group-small,
    .form-group-small input {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
      margin: 0 !important;
    }
  }
</style>

<script>
  // Expandable call form
  const callFormToggle = document.querySelector('.call-form-toggle') as HTMLButtonElement;
  const callFormContent = document.querySelector('.call-form-content') as HTMLElement;

  if (callFormToggle && callFormContent) {
    callFormToggle.addEventListener('click', () => {
      const expanded = callFormToggle.getAttribute('aria-expanded') === 'true';
      callFormToggle.setAttribute('aria-expanded', (!expanded).toString());
      callFormContent.classList.toggle('expanded');
    });

    if (window.location.hash === '#quick-call') {
      callFormToggle.setAttribute('aria-expanded', 'true');
      callFormContent.classList.add('expanded');
      setTimeout(() => {
        const quickCallSection = document.getElementById('quick-call');
        if (quickCallSection) {
          quickCallSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 100);
    }
  }
</script>