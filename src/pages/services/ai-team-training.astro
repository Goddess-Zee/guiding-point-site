---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="AI Team Training for Nonprofits & Government Contractors"
  description="Practical, hands-on AI training that helps nonprofit and GovCon teams adopt AI tools confidently — without losing accuracy, compliance, or trust."
>
  <style>
    .hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
    .hero-image {
      width: 100%;
      height: auto;
      border-radius: 4px;
      box-shadow: 0 12px 40px rgba(2,30,51,0.12);
      display: block;
      background: #f3f4f6;
      min-height: 320px;
      object-fit: cover;
    }
    @media (max-width: 768px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .hero-image-wrap {
        order: -1;
      }
    }
  </style>

  <main>
    <!-- Hero -->
    <section class="service-hero container">
      <div class="hero-grid">
        <div class="hero-text">
          <span class="eyebrow">AI Team Training</span>
          <h1>AI Team Training</h1>
          <p class="service-intro">
            Handing your team a login to an AI tool isn't training — it's a guessing game. Most
            teams end up either avoiding AI altogether or using it in ways that create real risk:
            inaccurate content, compliance gaps, or a loss of the voice that makes your organization
            trustworthy.
          </p>
          <p class="service-intro">
            Guiding Point Consulting delivers <strong>hands-on AI training for nonprofit and
            government contractor teams</strong> — practical sessions built around the actual tools
            and actual content your people work with every day, not generic AI 101.
          </p>
          <div class="cta-group" style="justify-content: flex-start;">
            <a href="/contact" class="btn btn-primary">Train Your Team</a>
          </div>
        </div>
        <div class="hero-image-wrap">
          <!-- PLACEHOLDER: swap src below with your chosen image -->
          <img
            src="/images/ai-team-training-page.webp"
            alt="AI team training illustration"
            class="hero-image"
          />
        </div>
      </div>
    </section>

    <!-- What You Get -->
    <section class="service-section container">
      <h2>What You Get</h2>
      <ul class="checklist">
        <li>Live, hands-on training sessions tailored to your team's actual workflows — not a canned webinar</li>
        <li>Clear guidance on where AI genuinely helps (drafting, research, first-pass summaries) and where it shouldn't be trusted unsupervised</li>
        <li>Simple, repeatable guardrails your team can use on their own after training ends</li>
        <li>Optional follow-up support as your team builds confidence and adjusts their workflow</li>
      </ul>
    </section>

    <!-- Who This Is For -->
    <section class="service-section container">
      <h2>Who This Is For</h2>
      <div class="audience-grid">
        <div class="audience-card">
          <p><strong>Nonprofits</strong> whose staff are curious about AI but unsure how to use it without risking accuracy or donor trust</p>
        </div>
        <div class="audience-card">
          <p><strong>Government prime contractors</strong> who need their subcontracted or internal teams trained on responsible AI use that meets compliance expectations</p>
        </div>
        <div class="audience-card">
          <p>Leadership teams who want AI adoption to be intentional, not accidental</p>
        </div>
      </div>

      <div class="not-this-box">
        <p><strong>What this is not:</strong> This isn't a one-hour "here's ChatGPT" demo. It's structured training built around your organization's real content, real compliance needs, and real risk tolerance.</p>
      </div>
    </section>

    <!-- Outcome -->
    <section class="service-section container">
      <div class="outcome-box">
        <h2>The Outcome</h2>
        <p>A team that uses AI confidently and correctly — faster first drafts, fewer bottlenecks, and none of the credibility risk that comes from careless AI use.</p>
      </div>

    </section>

    <!-- CTA -->
    <section class="service-cta container">
      <h2>Ready to Train Your Team?</h2>
      <p>Let's build training that fits your team's real workflows, not a generic AI demo.</p>
      <a href="/contact" class="btn btn-primary">Train Your Team</a>
    </section>
  </main>
</Layout>