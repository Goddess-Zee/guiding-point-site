---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Web Modernization, AI Content Ops & Digital Strategy | Guiding Point Consulting"
  description="Guiding Point Consulting delivers website modernization, AI content systems, team training, custom chatbots, and fractional digital strategy for government prime contractors and mission-based nonprofits."
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container hero-content">
      <h1>Services</h1>
      <p class="hero-text">Five ways to work together — whether you need to modernize a website, build AI content systems, train your team, add a custom AI assistant, or lead a complex digital initiative.</p>
      <p class="hero-subtext">Guiding Point partners with government prime contractors as a trusted subcontractor and works directly with mission-based nonprofits. Either way, the work is practical, human-centered, and built to last beyond the engagement.</p>
    </div>
  </section>

  <!-- Services Summary -->
  <section class="services-summary">
    <div class="container">
      <div class="summary-grid">

        <div class="summary-card">
          <div class="service-badge">01</div>
          <h3>Website Audit + Modernization Roadmap</h3>
          <p>Clarity on what to fix first — and a modern digital presence that works for humans and AI alike.</p>
          <a href="/services/website-modernization" class="btn btn-secondary">Learn More</a>
        </div>

        <div class="summary-card">
          <div class="service-badge">02</div>
          <h3>AI-Supported Content Operations</h3>
          <p>SOPs, prompts, QA, and workflows that help real humans ship better content, faster.</p>
          <a href="/services/ai-content-operations" class="btn btn-secondary">Learn More</a>
        </div>

        <div class="summary-card">
          <div class="service-badge">03</div>
          <h3>AI Team Training</h3>
          <p>Help your staff use AI safely and confidently in their day-to-day work.</p>
          <a href="/services/ai-team-training" class="btn btn-secondary">Learn More</a>
        </div>

        <div class="summary-card">
          <div class="service-badge">04</div>
          <h3>Custom Mission-Aware Chatbots and AI Assistants</h3>
          <p>AI built from your own content, in your own voice, designed for the people you serve.</p>
          <a href="/services/custom-ai-chatbots" class="btn btn-secondary">Learn More</a>
        </div>

        <div class="summary-card">
          <div class="service-badge">05</div>
          <h3>Fractional Digital Strategy Lead</h3>
          <p>A steady partner who keeps projects moving and conversations grounded in reality.</p>
          <a href="/services/fractional-digital-strategy" class="btn btn-secondary">Learn More</a>
        </div>

      </div>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="who-section">
    <div class="container">
      <h2 class="section-title">Who We Work With</h2>
      <div class="who-grid">
        <div class="who-card who-card--primary">
          <div class="who-badge">Primary</div>
          <h3>Government Prime Contractors</h3>
          <p class="who-label">Subcontract Support</p>
          <p>We support government primes as a qualified subcontractor delivering web modernization, AI content ops, team training, and digital strategy to the public sector clients, agencies, and communities their contracts serve. The prime stays on contract. We handle the digital and AI delivery.</p>
        </div>
        <div class="who-card">
          <div class="who-badge who-badge--secondary">Direct Engagements</div>
          <h3>Mission-Based Nonprofits</h3>
          <p>We work directly with nonprofit organizations that need clearer websites, smarter content systems, practical AI training, and custom chatbots designed for the realities of mission-driven work, limited capacity, and non-technical staff.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Not Sure CTA -->
  <section class="not-sure-section">
    <div class="container">
      <div class="not-sure-content">
        <h2>Not sure which fits? Or are you a prime looking for subcontract support?</h2>
        <p>Send a quick note about your project, contract, or organization and we will recommend the best starting point. No pressure, no hard sell.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Page Header ─────────────────────────────── */
  .page-header {
    background: var(--white);
    padding: var(--space-2xl) 0 var(--space-xl);
    border-bottom: 1px solid var(--gray-200);
  }

  .hero-content {
    text-align: center;
  }

  .page-header h1 {
    margin-bottom: var(--space-lg);
  }

  .hero-text {
    max-width: 700px;
    margin: 0 auto var(--space-md);
    font-size: 1.125rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  .hero-subtext {
    max-width: 750px;
    margin: 0 auto;
    font-size: 1rem;
    color: var(--gray-500);
    line-height: 1.7;
    font-style: italic;
  }

  /* ── Services Summary ────────────────────────── */
  .services-summary {
    padding: var(--space-3xl) 0;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
  }

  .summary-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: 12px;
    padding: var(--space-xl);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .summary-card:hover {
    border-color: var(--rust);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-4px);
  }

  .summary-card h3 {
    font-size: 1.25rem;
    color: var(--indigo);
    margin: var(--space-md) 0 var(--space-sm);
  }

  .summary-card p {
    color: var(--gray-600);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    flex-grow: 1;
  }

  .service-badge {
    display: inline-block;
    background: var(--rust);
    color: white;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.8rem;
    width: fit-content;
  }

  /* ── Who We Work With ────────────────────────── */
  .who-section {
    padding: var(--space-3xl) 0 var(--space-xl);
    background: var(--off-white);
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--indigo);
    text-align: center;
    margin-bottom: var(--space-xl);
    font-weight: 700;
  }

  .who-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .who-card {
    background: var(--white);
    padding: var(--space-xl);
    border-radius: 12px;
    border: 2px solid var(--gray-200);
    transition: all 0.3s ease;
    position: relative;
  }

  .who-card--primary {
    border-color: var(--rust);
    background: rgba(117, 19, 18, 0.03);
  }

  .who-card:hover {
    border-color: var(--rust);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(117, 19, 18, 0.1);
  }

  .who-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rust);
    background: rgba(117, 19, 18, 0.1);
    padding: 0.2rem 0.75rem;
    border-radius: 20px;
    margin-bottom: var(--space-sm);
  }

  .who-badge--secondary {
    color: var(--indigo);
    background: rgba(2, 30, 51, 0.08);
  }

  .who-card h3 {
    font-size: 1.25rem;
    color: var(--indigo);
    margin-bottom: var(--space-sm);
  }

  .who-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--rust);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .who-card p {
    color: var(--gray-700);
    line-height: 1.7;
    margin-bottom: 0;
  }

  /* ── Not Sure Section ────────────────────────── */
  .not-sure-section {
    padding: var(--space-3xl) 0;
    background: linear-gradient(135deg, rgba(117, 19, 18, 0.05) 0%, rgba(2, 30, 51, 0.05) 100%);
  }

  .not-sure-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .not-sure-content h2 {
    margin-bottom: var(--space-md);
  }

  .not-sure-content p {
    margin-bottom: var(--space-lg);
    font-size: 1.25rem;
    color: var(--gray-700);
    line-height: 1.7;
  }

  /* ── Buttons ─────────────────────────────────── */
  a.btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: 2px solid transparent;
  }

  a.btn-primary {
    background: var(--rust);
    color: var(--white);
  }

  a.btn-primary:hover {
    background: #5a0e0d;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(117, 19, 18, 0.3);
  }

  a.btn-secondary {
    background: var(--white);
    color: var(--indigo);
    border-color: var(--gray-300);
  }

  a.btn-secondary:hover {
    border-color: var(--rust);
    color: var(--rust);
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 768px) {
    .who-grid,
    .summary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>