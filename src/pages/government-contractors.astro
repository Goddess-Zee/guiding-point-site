---
import Layout from '../layouts/Layout.astro';

const title = "Government Contractor Website Modernization + AI Systems | Guiding Point Consulting";
const description = "Guiding Point Consulting is a WBE/MBE-certified subcontractor delivering website modernization, AI content operations, and team training for government prime contractors.";
---

<Layout title={title} description={description}>

  <!-- HERO -->
  <section class="gov-hero">
    <div class="gov-container">
      <p class="gov-eyebrow">For Government Prime Contractors</p>
      <h1 class="gov-hero-headline">A subcontractor partner who delivers digital modernization on time, in scope, in compliance.</h1>
      <p class="gov-hero-sub">
        We're a certified WBE/MBE subcontractor delivering website modernization, AI content
        operations, and team training to the public sector clients and communities your contract
        serves. You stay accountable to the prime relationship. We handle the digital and AI delivery.
      </p>
      <div class="gov-hero-ctas">
        <a href="/contact" class="gov-btn-primary">Discuss Subcontract Support</a>
        <a href="#services" class="gov-btn-secondary">See How We Help →</a>
      </div>
    </div>
  </section>

  <!-- BELIEF BAR -->
  <section class="gov-belief">
    <div class="gov-container">
      <p class="gov-belief-text">
        "Certified small business delivery, built to meet your compliance and reporting requirements, not just your deadline."
      </p>
    </div>
  </section>

  <!-- THE REAL PROBLEM -->
  <section class="gov-problem">
    <div class="gov-container gov-two-col">
      <div class="gov-problem-copy">
        <p class="gov-section-label">Why GovCon Digital Delivery Stalls</p>
        <h2>It's not a capability problem. It's a bandwidth and compliance problem.</h2>
        <p>
          Most primes don't lack the will to modernize a client's digital presence. They lack a
          qualified small-business partner who understands both the technical work and the
          reporting, compliance, and socioeconomic requirements that come with a federal or
          state contract.
        </p>
        <p>
          Digital and AI requirements get added to scope late, with no internal bandwidth to
          deliver them. Existing vendors don't understand subcontract reporting.
        </p>
        <p>
          We built Guiding Point for exactly this situation.
        </p>
      </div>
      <div class="gov-problem-signals">
        <p class="gov-signals-label">Sound familiar?</p>
        <ul class="gov-signals-list">
          <li>Digital modernization or AI requirements got added to scope late, with no internal bandwidth to deliver</li>
          <li>You need WBE/MBE subcontractor participation to meet socioeconomic goals, but haven't found a qualified technical partner</li>
          <li>Accessibility (Section 508 / WCAG) and security requirements are unclear to your current web vendor</li>
          <li>Your existing vendor doesn't understand subcontract reporting, deliverables, or compliance documentation</li>
          <li>Deadlines are tied to contract milestones, there's no room for a slow discovery process</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="gov-services" id="services">
    <div class="gov-container">
      <p class="gov-section-label">What We Do</p>
      <h2>Five ways to work together.</h2>
      <p class="gov-services-intro">
        Every engagement is scoped to fit within your contract's requirements and reporting
        needs, not a generic agency package. We deliver as a qualified subcontractor across the
        life of the engagement.
      </p>

      <div class="gov-services-grid">

        <div class="gov-service-card">
          <span class="gov-service-num">01</span>
          <h3>Website Audit + Modernization Roadmap</h3>
          <p>
            A structured review of clarity, usability, accessibility, and search visibility for
            the client-facing or internal digital property your contract covers, with a
            prioritized roadmap your team and the client can agree on.
          </p>
          <p class="gov-service-ideal">
            <strong>Ideal for:</strong> Contracts requiring web modernization, accessibility remediation, or digital content improvements as a deliverable.
          </p>
          <a href="/services/website-modernization" class="gov-service-link">Learn More →</a>
        </div>

        <div class="gov-service-card">
          <span class="gov-service-num">02</span>
          <h3>AI-Supported Content Operations</h3>
          <p>
            We build documented content systems: SOPs, templates, prompt libraries, and
            publishing workflows that meet compliance and brand-voice requirements for the
            organizations your contract serves.
          </p>
          <p class="gov-service-ideal">
            <strong>Ideal for:</strong> Contracts requiring documented AI-assisted content systems as part of a digital modernization deliverable.
          </p>
          <a href="/services/ai-content-operations" class="gov-service-link">Learn More →</a>
        </div>

        <div class="gov-service-card">
          <span class="gov-service-num">03</span>
          <h3>AI Team Training</h3>
          <p>
            Plain-language AI literacy and adoption training, delivered as qualified subcontract
            support, for the client organizations and staff your contract serves. Guardrails for
            privacy, compliance, and brand voice included.
          </p>
          <p class="gov-service-ideal">
            <strong>Ideal for:</strong> Contracts that include AI literacy or digital capacity-building requirements.
          </p>
          <a href="/services/ai-team-training" class="gov-service-link">Learn More →</a>
        </div>

        <div class="gov-service-card">
          <span class="gov-service-num">04</span>
          <h3>Custom Mission-Aware AI Assistants</h3>
          <p>
            A chatbot trained on the client's FAQs, programs, and documents, reducing repetitive
            support load on staff while giving the public accurate, on-brand answers. Fully
            documented, no vendor lock-in.
          </p>
          <p class="gov-service-ideal">
            <strong>Ideal for:</strong> Contracts that include AI tool implementation or digital capacity building for client organizations.
          </p>
          <a href="/services/custom-ai-chatbots" class="gov-service-link">Learn More →</a>
        </div>

        <div class="gov-service-card">
          <span class="gov-service-num">05</span>
          <h3>Fractional Digital Strategy Lead</h3>
          <p>
            Senior digital strategy leadership as ongoing subcontract support, keeping web,
            content, and AI workstreams moving, vendors accountable, and stakeholders aligned
            across the life of the contract.
          </p>
          <p class="gov-service-ideal">
            <strong>Ideal for:</strong> Contracts needing a reliable subcontract digital strategy partner across multiple workstreams.
          </p>
          <a href="/services/fractional-digital-strategy" class="gov-service-link">Learn More →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- DIFFERENTIATOR -->
  <section class="gov-diff">
    <div class="gov-container">
      <p class="gov-section-label">Why Guiding Point</p>
      <h2>A subcontractor who understands delivery, not just design.</h2>
      <div class="gov-diff-grid">
        <div class="gov-diff-card">
          <h4>Clarity before complexity.</h4>
          <p>
            We diagnose what's broken before recommending what to build, so your client gets
            the right fix, not the most expensive one.
          </p>
        </div>
        <div class="gov-diff-card">
          <h4>AI that meets compliance.</h4>
          <p>
            We implement AI tools with guardrails, governance, and documentation built around
            your compliance and reporting requirements.
          </p>
        </div>
        <div class="gov-diff-card">
          <h4>Systems the client can run.</h4>
          <p>
            Everything we deliver includes documentation, SOPs, and prompt libraries. No
            dependency on us to keep it running after the contract closes out.
          </p>
        </div>
        <div class="gov-diff-card">
          <h4>Certified small business delivery.</h4>
          <p>
            We're a certified WBE/MBE firm, SAM.gov registered, built to help you meet
            socioeconomic participation goals without cutting corners on delivery.
          </p>
        </div>
      </div>
      <div class="gov-certs">
        <span>SAM.gov Registered</span>
        <span>·</span>
        <span>Florida OSD/DMS Certified</span>
        <span>·</span>
        <span>WBE + MBE Certified</span>
        <span>·</span>
        <span>SBA Certification in Progress</span>
      </div>
    </div>
  </section>

  <!-- CAPABILITY CTA -->
  <section class="gov-audit-cta">
    <div class="gov-container gov-audit-inner">
      <div class="gov-audit-copy">
        <h2>Not sure where to start? Start with a capability conversation.</h2>
        <p>
          A 30-minute conversation will surface where we fit into your contract's digital or AI
          requirements, no obligation, no pressure to sign anything. You'll leave with a clear
          sense of where a subcontract relationship makes sense, even if we never work together.
        </p>
        <a href="/contact" class="gov-btn-primary">Discuss Teaming Opportunities</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Tokens ── */
  :root {
    --gov-navy:   #32345A;
    --gov-red:    #AC3430;
    --gov-blush:  #F4E5E2;
    --gov-beige:  #F9EAC5;
    --gov-white:  #FDFBFB;
    --gov-light:  #F4E5E2;
    --gov-text:   #1A1A1A;
    --gov-muted:  #555;
  }

  /* ── Layout ── */
  .gov-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .gov-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── Shared Labels ── */
  .gov-section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gov-red);
    margin-bottom: 0.75rem;
  }

  /* ── Hero ── */
  .gov-hero {
    background-color: var(--gov-navy);
    color: var(--gov-white);
    padding: 5rem 0 4rem;
  }

  .gov-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gov-beige);
    margin-bottom: 1.25rem;
  }

  .gov-hero-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    max-width: 820px;
    margin-bottom: 1.5rem;
    color: var(--gov-white);
  }

  .gov-hero-sub {
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 660px;
    color: rgba(253,251,251,0.85);
    margin-bottom: 2.5rem;
  }

  .gov-hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── Buttons ── */
  .gov-btn-primary {
    display: inline-block;
    background-color: var(--gov-red);
    color: var(--gov-white);
    padding: 0.85rem 1.75rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .gov-btn-primary:hover {
    background-color: #8f2b28;
  }

  .gov-btn-secondary {
    display: inline-block;
    color: var(--gov-beige);
    padding: 0.85rem 0;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid var(--gov-beige);
    transition: opacity 0.2s ease;
  }
  .gov-btn-secondary:hover {
    opacity: 0.75;
  }

  /* ── Belief Bar ── */
  .gov-belief {
    background-color: var(--gov-beige);
    padding: 2rem 0;
  }

  .gov-belief-text {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 600;
    font-style: italic;
    color: var(--gov-navy);
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* ── Problem ── */
  .gov-problem {
    padding: 5rem 0;
    background-color: var(--gov-white);
  }

  .gov-problem-copy h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--gov-navy);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .gov-problem-copy p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--gov-muted);
    margin-bottom: 1rem;
  }

  .gov-signals-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gov-red);
    margin-bottom: 1rem;
  }

  .gov-signals-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .gov-signals-list li {
    font-size: 0.975rem;
    line-height: 1.5;
    color: var(--gov-text);
    padding-left: 1.25rem;
    position: relative;
  }

  .gov-signals-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--gov-red);
    font-weight: 700;
  }

  /* ── Services ── */
  .gov-services {
    padding: 5rem 0;
    background-color: var(--gov-light);
  }

  .gov-services h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--gov-navy);
    margin-bottom: 0.75rem;
  }

  .gov-services-intro {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--gov-muted);
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .gov-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .gov-service-card {
    background: var(--gov-white);
    border-radius: 6px;
    padding: 2rem;
    border-top: 3px solid var(--gov-navy);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gov-service-num {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--gov-red);
    text-transform: uppercase;
  }

  .gov-service-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--gov-navy);
    line-height: 1.3;
    margin: 0;
  }

  .gov-service-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--gov-muted);
    margin: 0;
  }

  .gov-service-ideal {
    font-size: 0.875rem !important;
    color: var(--gov-text) !important;
    background: var(--gov-beige);
    padding: 0.6rem 0.85rem;
    border-radius: 4px;
  }

  .gov-service-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--gov-red);
    text-decoration: none;
    margin-top: auto;
    transition: opacity 0.2s;
  }
  .gov-service-link:hover {
    opacity: 0.7;
  }

  /* ── Differentiator ── */
  .gov-diff {
    padding: 5rem 0;
    background-color: var(--gov-white);
  }

  .gov-diff h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--gov-navy);
    max-width: 600px;
    margin-bottom: 2.5rem;
    line-height: 1.2;
  }

  .gov-diff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .gov-diff-card h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--gov-navy);
    margin-bottom: 0.5rem;
  }

  .gov-diff-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--gov-muted);
  }

  .gov-certs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--gov-muted);
    letter-spacing: 0.03em;
    border-top: 1px solid #ddd;
    padding-top: 1.5rem;
  }

  /* ── Audit/Capability CTA ── */
  .gov-audit-cta {
    background-color: var(--gov-navy);
    padding: 5rem 0;
  }

  .gov-audit-inner {
    max-width: 680px;
  }

  .gov-audit-copy h2 {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 800;
    color: var(--gov-white);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .gov-audit-copy p {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(253,251,251,0.85);
    margin-bottom: 2rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .gov-two-col {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .gov-hero {
      padding: 3.5rem 0 3rem;
    }

    .gov-services,
    .gov-problem,
    .gov-diff,
    .gov-audit-cta {
      padding: 3.5rem 0;
    }

    .gov-hero-ctas {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>