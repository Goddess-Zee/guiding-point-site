---
import Layout from '../layouts/Layout.astro';

const title = "Nonprofit Website Modernization + AI Tools | Guiding Point Consulting";
const description = "Guiding Point Consulting helps nonprofits modernize outdated websites, build AI content workflows, and train staff to use AI confidently. Practical digital strategy for mission-driven teams that keeps people at the center.";
---

<Layout title={title} description={description}>

  <!-- HERO -->
  <section class="nfp-hero">
    <div class="nfp-container">
      <p class="nfp-eyebrow">For Nonprofits + Mission-Driven Organizations</p>
      <h1 class="nfp-hero-headline">Your mission deserves a digital presence that actually works for people.</h1>
      <p class="nfp-hero-sub">
        Technology should bring people closer, not replace the connection between them.
        We help nonprofits modernize their websites, build sustainable AI content workflows,
        and train the staff who'll run them, without losing what makes your organization human.
      </p>
      <div class="nfp-hero-ctas">
        <a href="/contact" class="nfp-btn-primary">Request a Free Website Audit</a>
        <a href="#services" class="nfp-btn-secondary">See How We Help →</a>
      </div>
    </div>
  </section>

  <!-- BELIEF BAR -->
  <section class="nfp-belief">
    <div class="nfp-container">
      <p class="nfp-belief-text">
        "AI is getting smarter. We build the systems that keep people at the center of it."
      </p>
    </div>
  </section>

  <!-- THE REAL PROBLEM -->
  <section class="nfp-problem">
    <div class="nfp-container nfp-two-col">
      <div class="nfp-problem-copy">
        <p class="nfp-section-label">Why Nonprofit Websites Struggle</p>
        <h2>It's not a budget problem. It's a systems problem.</h2>
        <p>
          Most nonprofit websites don't fail because of bad intentions. They fail because they
          were built for launch, not for the two or three staff members who have to keep them
          running after the consultant is gone.
        </p>
        <p>
          Content stalls. AI tools get adopted inconsistently. Leadership wants to modernize
          but doesn't know where to start without a six-figure agency budget.
        </p>
        <p>
          We built Guiding Point for exactly this situation.
        </p>
      </div>
      <div class="nfp-problem-signals">
        <p class="nfp-signals-label">Sound familiar?</p>
        <ul class="nfp-signals-list">
          <li>Your website was last updated when someone had "a minute"</li>
          <li>Staff are using AI tools but nobody's sure they're doing it right</li>
          <li>Content approvals live in someone's inbox, not a workflow</li>
          <li>You know the site isn't working, you just don't know where to start</li>
          <li>A redesign feels too expensive, but the current site is costing you trust</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="nfp-services" id="services">
    <div class="nfp-container">
      <p class="nfp-section-label">What We Do</p>
      <h2>Five ways to work together.</h2>
      <p class="nfp-services-intro">
        Every engagement is built around your actual capacity, not what we wish you had.
        We work directly with nonprofits and mission-driven organizations at any stage of digital maturity.
      </p>

      <div class="nfp-services-grid">

        <div class="nfp-service-card">
          <span class="nfp-service-num">01</span>
          <h3>Website Audit + Modernization Roadmap</h3>
          <p>
            A structured review of your site's clarity, usability, accessibility, and search
            visibility, with a prioritized action plan your team and leadership can actually
            agree on. We tell you what to fix first, why it matters, and how much effort each
            piece takes.
          </p>
          <p class="nfp-service-ideal">
            <strong>Ideal for:</strong> Organizations planning a redesign, or those who know something's wrong but aren't sure what.
          </p>
          <a href="/services/website-modernization" class="nfp-service-link">Learn More →</a>
        </div>

        <div class="nfp-service-card">
          <span class="nfp-service-num">02</span>
          <h3>AI-Supported Content Operations</h3>
          <p>
            We build the content systems your communications and program staff have needed for
            years: SOPs, templates, prompt libraries, and publishing workflows that reduce
            bottlenecks without adding complexity. Human-centered by design.
          </p>
          <p class="nfp-service-ideal">
            <strong>Ideal for:</strong> Teams where content gets stuck in drafts, approvals, or one person's head.
          </p>
          <a href="/services/ai-content-operations" class="nfp-service-link">Learn More →</a>
        </div>

        <div class="nfp-service-card">
          <span class="nfp-service-num">03</span>
          <h3>AI Team Training</h3>
          <p>
            Plain-language AI training built around your actual tools, your content, and your
            staff's real comfort level. Nobody leaves confused about what to do, or afraid of
            doing it wrong. Guardrails for privacy, compliance, and brand voice included.
          </p>
          <p class="nfp-service-ideal">
            <strong>Ideal for:</strong> Organizations where AI adoption is inconsistent, uneven, or anxiety-inducing.
          </p>
          <a href="/services/ai-team-training" class="nfp-service-link">Learn More →</a>
        </div>

        <div class="nfp-service-card">
          <span class="nfp-service-num">04</span>
          <h3>Custom Mission-Aware AI Assistants</h3>
          <p>
            A chatbot trained on your FAQs, programs, and documents, so visitors get answers
            and staff stop fielding the same five questions every day. Built in your voice,
            owned by your organization, with no vendor lock-in.
          </p>
          <p class="nfp-service-ideal">
            <strong>Ideal for:</strong> Organizations with high visitor volume or complex program offerings.
          </p>
          <a href="/services/custom-ai-chatbots" class="nfp-service-link">Learn More →</a>
        </div>

        <div class="nfp-service-card">
          <span class="nfp-service-num">05</span>
          <h3>Fractional Digital Strategy Lead</h3>
          <p>
            Senior digital guidance without the full-time cost. We stay engaged month to month,
            keeping your digital roadmap moving, vendors accountable, and leadership aligned
            one point of contact who bridges tech, creativity, and the human side of change.
          </p>
          <p class="nfp-service-ideal">
            <strong>Ideal for:</strong> Organizations that need a strategic partner, not just another vendor.
          </p>
          <a href="/services/fractional-digital-strategy" class="nfp-service-link">Learn More →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- DIFFERENTIATOR -->
  <section class="nfp-diff">
    <div class="nfp-container">
      <p class="nfp-section-label">Why Guiding Point</p>
      <h2>We're not here to build something beautiful and disappear.</h2>
      <div class="nfp-diff-grid">
        <div class="nfp-diff-card">
          <h4>Clarity before complexity.</h4>
          <p>
            We diagnose what's broken before recommending what to build. Most organizations
            need better structure and clearer language, not a new platform.
          </p>
        </div>
        <div class="nfp-diff-card">
          <h4>AI that works for humans.</h4>
          <p>
            We implement AI tools with guardrails, governance, and real training, so staff
            feel confident using them, not afraid of getting something wrong.
          </p>
        </div>
        <div class="nfp-diff-card">
          <h4>Systems your team can run.</h4>
          <p>
            Everything we deliver includes documentation, SOPs, and prompt libraries.
            You shouldn't need us on retainer just to keep the lights on.
          </p>
        </div>
        <div class="nfp-diff-card">
          <h4>Right-sized for your budget.</h4>
          <p>
            We're a certified WBE/MBE firm built to bring focused, practical expertise to
            engagements that don't have large agency budgets, without cutting corners.
          </p>
        </div>
      </div>
      <div class="nfp-certs">
        <span>Florida OSD/DMS Certified</span>
        <span>·</span>
        <span>WBE + MBE Certified</span>
        <span>·</span>
        <span>SBA Certification in Progress</span>
      </div>
    </div>
  </section>

  <!-- FREE AUDIT CTA -->
  <section class="nfp-audit-cta">
    <div class="nfp-container nfp-audit-inner">
      <div class="nfp-audit-copy">
        <h2>Not sure where to start? Start with a free website audit.</h2>
        <p>
          A 30-minute conversation will surface your three biggest opportunities for clarity,
          search visibility, and connection with the people you serve, at no cost, no obligation.
          You'll leave with a clear sense of what to fix first, even if we never work together.
        </p>
        <a href="/contact" class="nfp-btn-primary">Request Your Free Audit</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Tokens (2026 rebrand) ── */
  :root {
    --nfp-navy:   #021E33; /* prussian-blue */
    --nfp-red:    #751312; /* dark-wine */
    --nfp-blush:  #F7F0E7; /* linen */
    --nfp-beige:  #F7F0E7; /* linen */
    --nfp-white:  #FDFBFB;
    --nfp-light:  #F7F0E7; /* linen */
    --nfp-text:   #1A1A1A;
    --nfp-muted:  #555;
  }

  /* ── Layout ── */
  .nfp-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nfp-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── Shared Labels ── */
  .nfp-section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--nfp-red);
    margin-bottom: 0.75rem;
  }

  /* ── Hero ── */
  .nfp-hero {
    background-color: var(--nfp-navy);
    color: var(--nfp-white);
    padding: 5rem 0 4rem;
  }

  .nfp-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nfp-beige);
    margin-bottom: 1.25rem;
  }

  .nfp-hero-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    max-width: 820px;
    margin-bottom: 1.5rem;
    color: var(--nfp-white);
  }

  .nfp-hero-sub {
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 660px;
    color: rgba(253,251,251,0.85);
    margin-bottom: 2.5rem;
  }

  .nfp-hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── Buttons ── */
  .nfp-btn-primary {
    display: inline-block;
    background-color: var(--nfp-red);
    color: var(--nfp-white);
    padding: 0.85rem 1.75rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .nfp-btn-primary:hover {
    background-color: #5a0e0d;
  }

  .nfp-btn-secondary {
    display: inline-block;
    color: var(--nfp-beige);
    padding: 0.85rem 0;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid var(--nfp-beige);
    transition: opacity 0.2s ease;
  }
  .nfp-btn-secondary:hover {
    opacity: 0.75;
  }

  /* ── Belief Bar ── */
  .nfp-belief {
    background-color: var(--nfp-beige);
    padding: 2rem 0;
  }

  .nfp-belief-text {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 600;
    font-style: italic;
    color: var(--nfp-navy);
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* ── Problem ── */
  .nfp-problem {
    padding: 5rem 0;
    background-color: var(--nfp-white);
  }

  .nfp-problem-copy h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--nfp-navy);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .nfp-problem-copy p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--nfp-muted);
    margin-bottom: 1rem;
  }

  .nfp-signals-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nfp-red);
    margin-bottom: 1rem;
  }

  .nfp-signals-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .nfp-signals-list li {
    font-size: 0.975rem;
    line-height: 1.5;
    color: var(--nfp-text);
    padding-left: 1.25rem;
    position: relative;
  }

  .nfp-signals-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--nfp-red);
    font-weight: 700;
  }

  /* ── Services ── */
  .nfp-services {
    padding: 5rem 0;
    background-color: var(--nfp-light);
  }

  .nfp-services h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--nfp-navy);
    margin-bottom: 0.75rem;
  }

  .nfp-services-intro {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--nfp-muted);
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .nfp-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .nfp-service-card {
    background: var(--nfp-white);
    border-radius: 6px;
    padding: 2rem;
    border-top: 3px solid var(--nfp-navy);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nfp-service-num {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--nfp-red);
    text-transform: uppercase;
  }

  .nfp-service-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--nfp-navy);
    line-height: 1.3;
    margin: 0;
  }

  .nfp-service-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--nfp-muted);
    margin: 0;
  }

  .nfp-service-ideal {
    font-size: 0.875rem !important;
    color: var(--nfp-text) !important;
    background: var(--nfp-beige);
    padding: 0.6rem 0.85rem;
    border-radius: 4px;
  }

  .nfp-service-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--nfp-red);
    text-decoration: none;
    margin-top: auto;
    transition: opacity 0.2s;
  }
  .nfp-service-link:hover {
    opacity: 0.7;
  }

  /* ── Differentiator ── */
  .nfp-diff {
    padding: 5rem 0;
    background-color: var(--nfp-white);
  }

  .nfp-diff h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--nfp-navy);
    max-width: 600px;
    margin-bottom: 2.5rem;
    line-height: 1.2;
  }

  .nfp-diff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .nfp-diff-card h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--nfp-navy);
    margin-bottom: 0.5rem;
  }

  .nfp-diff-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--nfp-muted);
  }

  .nfp-certs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--nfp-muted);
    letter-spacing: 0.03em;
    border-top: 1px solid #ddd;
    padding-top: 1.5rem;
  }

  /* ── Audit CTA ── */
  .nfp-audit-cta {
    background-color: var(--nfp-navy);
    padding: 5rem 0;
  }

  .nfp-audit-inner {
    max-width: 680px;
  }

  .nfp-audit-copy h2 {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 800;
    color: var(--nfp-white);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .nfp-audit-copy p {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(253,251,251,0.85);
    margin-bottom: 2rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nfp-two-col {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .nfp-hero {
      padding: 3.5rem 0 3rem;
    }

    .nfp-services,
    .nfp-problem,
    .nfp-diff,
    .nfp-audit-cta {
      padding: 3.5rem 0;
    }

    .nfp-hero-ctas {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>