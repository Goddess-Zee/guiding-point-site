---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Capability Statement | Guiding Point Consulting LLC"
  description="Guiding Point Consulting LLC capability statement — website modernization and digital systems subcontractor supporting government prime contractors. UEI: M71FSMNQ67L8, CAGE: 1A0E2."
>
  <!-- Header -->
  <section class="cap-hero">
    <div class="container">
      <div class="cap-hero-content">
        <div class="cap-hero-text">
          <p class="cap-eyebrow">Capability Statement</p>
          <h1>Guiding Point Consulting LLC</h1>
          <p class="cap-subtitle">Website Modernization and Digital Systems Subcontractor Supporting Government Prime Contractors</p>
        </div>
        <div class="cap-hero-actions">
          <a href="/capability-statement.pdf" download class="btn btn-primary">
            ↓ Download PDF
          </a>
          <a href="/contact" class="btn btn-outline">Partner With Us</a>
        </div>
      </div>

      <!-- Contact Bar -->
      <div class="contact-bar">
        <div class="contact-bar-item">
          <span class="contact-icon">📞</span>
          <a href="tel:7545811042">754-581-1042</a>
        </div>
        <div class="contact-bar-item">
          <span class="contact-icon">✉</span>
          <a href="mailto:zbanyay@guidingpointconsults.com">zbanyay@guidingpointconsults.com</a>
        </div>
        <div class="contact-bar-item">
          <span class="contact-icon">🌐</span>
          <a href="https://guidingpointconsults.com">guidingpointconsults.com</a>
        </div>
        <div class="contact-bar-item">
          <span class="contact-icon">📍</span>
          <span>Tampa, FL</span>
        </div>
        <div class="contact-bar-item">
          <span class="contact-label">Business POC:</span>
          <span>Zipporah Banyay, Principal Consultant &amp; CEO</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="cap-body">
    <div class="container">
      <div class="cap-grid">

        <!-- Left Column -->
        <div class="cap-left">

          <!-- Company Overview -->
          <div class="cap-block">
            <h2 class="cap-block-title">Company Overview</h2>
            <p>Guiding Point Consulting LLC supports government prime contractors as a subcontractor, strengthening delivery to the organizations they serve. We specialize in website modernization, workflow automation, AI team training, and fractional marketing and operations leadership, ensuring solutions are clear, usable, and sustainable for real teams in public sector and mission-driven environments.</p>
          </div>

          <!-- Core Competencies -->
          <div class="cap-block">
            <h2 class="cap-block-title">Core Competencies</h2>
            <ul class="cap-list">
              <li>Website Modernization, including Site Builder to Custom Code Migration</li>
              <li>SEO, AEO, and GEO (Search and AI Discoverability)</li>
              <li>Workflow Automation and Process Systems</li>
              <li>AI Team Training and Workforce Development</li>
              <li>Fractional Marketing and Operations Leadership</li>
              <li>Website and Marketing Systems Consulting</li>
            </ul>
          </div>

          <!-- Differentiators -->
          <div class="cap-block">
            <h2 class="cap-block-title">Differentiators</h2>
            <ul class="cap-list cap-list--check">
              <li>Delivery-focused approach — usability and sustainability built in from the start</li>
              <li>Bridges technical and non-technical teams across contracts</li>
              <li>Systems and adoption focus, not just implementation</li>
              <li>Mission-driven experience supporting public sector and nonprofit organizations</li>
            </ul>
          </div>

          <!-- NAICS -->
          <div class="cap-block">
            <h2 class="cap-block-title">NAICS Codes</h2>
            <ul class="naics-list">
              <li><strong>541618</strong> — Management Consulting (Operations, Workflows, and Fractional Leadership)</li>
              <li><strong>541512</strong> — Computer Systems Design (Web and Digital Platforms)</li>
              <li><strong>541511</strong> — Custom Programming (Web Development and Integrations)</li>
              <li><strong>611420</strong> — Computer Training (AI Team Training and Workforce Development)</li>
              <li><strong>541613</strong> — Marketing Consulting (Messaging and Content Strategy)</li>
            </ul>
          </div>

        </div>

        <!-- Right Column -->
        <div class="cap-right">

          <!-- Past Performance -->
          <div class="cap-block">
            <h2 class="cap-block-title">Past Performance</h2>

            <div class="perf-card">
              <h3>Website Design and Lead-Focused Build</h3>
              <p class="perf-org">Residential Renovation Company · Role: Delivery Lead</p>
              <ul class="perf-list">
                <li>Designed and built a mobile-first, custom-coded website with separate paths for homeowners and property investors</li>
                <li>Result: quote-request lead capture and a self-updating project gallery the team maintains without a developer</li>
              </ul>
            </div>

            <div class="perf-card">
              <h3>Organization-Wide Workflow and Operations System</h3>
              <p class="perf-org">Multi-Department Organization · Role: Fractional Digital Strategy and Operations Lead</p>
              <ul class="perf-list">
                <li>Led executive discovery, department interviews, and a cross-level audit; built SOPs, a source-of-truth knowledge library, and department workflows</li>
                <li>Result: clear ownership, consistent handoffs, and faster onboarding across departments</li>
              </ul>
            </div>

            <div class="perf-card">
              <h3>AI Content Operations System and Team Enablement</h3>
              <p class="perf-org">Growth-Focused Service Organization · Role: AI Operations Lead</p>
              <ul class="perf-list">
                <li>Built a fact-checked knowledge base, a production prompt library, and QA and governance guardrails for organization-specific AI</li>
                <li>Result: reliable, on-brand AI outputs with less rewriting and greater staff trust in AI tools</li>
              </ul>
            </div>
          </div>

          <!-- Company Data -->
          <div class="cap-block cap-block--data">
            <h2 class="cap-block-title">Company Data</h2>
            <div class="data-grid">
              <div class="data-item">
                <span class="data-label">UEI</span>
                <span class="data-value">M71FSMNQ67L8</span>
              </div>
              <div class="data-item">
                <span class="data-label">CAGE</span>
                <span class="data-value">1A0E2</span>
              </div>
              <div class="data-item">
              <span class="data-label" style="color: var(--indigo); font-weight: 700;">Certifications & Designations</span>
              </div>
              <div class="data-item">
                <span class="data-label">WBE</span>
                <span class="data-value">State of Florida (OSD/DMS)</span>
              </div>
              <div class="data-item">
                <span class="data-label">MBE</span>
                <span class="data-value">State of Florida (OSD/DMS)</span>
              </div>
              <div class="data-item">
                <span class="data-label">SBE</span>
                <span class="data-value">Hillsborough County</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="cap-cta">
    <div class="container">
      <div class="cap-cta-content">
        <h2>Ready to discuss a subcontract partnership?</h2>
        <p>Download the capability statement or reach out directly to start the conversation.</p>
        <div class="cap-cta-buttons">
          <a href="/capability-statement.pdf" download class="btn btn-white">↓ Download Capability Statement</a>
          <a href="/contact" class="btn btn-outline-white">Partner With Us</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ────────────────────────────────────── */
  .cap-hero {
    background: var(--white);
    padding: var(--space-2xl) 0 0;
    border-bottom: 1px solid var(--gray-200);
  }

  .cap-hero-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .cap-hero-text {
    flex: 1;
    min-width: 280px;
  }

  .cap-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--rust);
    margin-bottom: var(--space-sm);
  }

  .cap-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--indigo);
    margin-bottom: var(--space-sm);
    line-height: 1.15;
  }

  .cap-subtitle {
    font-size: 1.125rem;
    color: var(--gray-600);
    line-height: 1.6;
    font-weight: 500;
  }

  .cap-hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-end;
    flex-shrink: 0;
  }

  /* ── Contact Bar ─────────────────────────────── */
  .contact-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    background: var(--indigo);
    border-radius: 8px 8px 0 0;
    margin: 0 0 0 0;
  }

  .contact-bar-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .contact-bar-item a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-bar-item a:hover { color: var(--white); text-decoration: underline; }

  .contact-icon { font-size: 1rem; }

  .contact-label {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ── Body ────────────────────────────────────── */
  .cap-body {
    padding: var(--space-2xl) 0;
    background: var(--off-white);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  /* ── Blocks ──────────────────────────────────── */
  .cap-block {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: 10px;
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .cap-block:last-child { margin-bottom: 0; }

  .cap-block-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--indigo);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--rust);
    display: inline-block;
  }

  .cap-block p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--gray-700);
  }

  /* ── Lists ───────────────────────────────────── */
  .cap-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cap-list li {
    padding-left: 1.5rem;
    margin-bottom: var(--space-sm);
    position: relative;
    color: var(--gray-700);
    font-size: 0.975rem;
    line-height: 1.6;
  }

  .cap-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--rust);
    font-weight: 600;
  }

  .cap-list--check li::before {
    content: '✓';
    color: var(--rust);
    font-weight: 700;
  }

  /* ── NAICS ───────────────────────────────────── */
  .naics-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .naics-list li {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--gray-100);
    font-size: 0.9rem;
    color: var(--gray-700);
    line-height: 1.5;
  }

  .naics-list li:last-child { border-bottom: none; }

  .naics-list strong {
    color: var(--indigo);
    font-weight: 700;
    margin-right: 0.25rem;
  }

  /* ── Past Performance ────────────────────────── */
  .perf-card {
    padding: var(--space-md);
    background: var(--off-white);
    border-radius: 8px;
    border-left: 3px solid var(--rust);
    margin-bottom: var(--space-md);
  }

  .perf-card:last-child { margin-bottom: 0; }

  .perf-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--indigo);
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .perf-org {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--rust);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .perf-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .perf-list li {
    padding-left: 1.25rem;
    margin-bottom: 0.4rem;
    position: relative;
    font-size: 0.9rem;
    color: var(--gray-700);
    line-height: 1.6;
  }

  .perf-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--rust);
    font-weight: 700;
  }

  /* ── Company Data ────────────────────────────── */
  .cap-block--data {
    background: rgba(2, 30, 51, 0.04);
    border-color: rgba(2, 30, 51, 0.15);
  }

  .data-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .data-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    background: var(--white);
    border-radius: 6px;
    border: 1px solid var(--gray-200);
  }

  .data-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gray-600);
  }

  .data-value {
    font-size: 1rem;
    font-weight: 700;
    color: var(--indigo);
    font-family: monospace;
    letter-spacing: 0.05em;
  }

  /* ── Buttons ─────────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    font-size: 1rem;
    text-align: center;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--rust);
    color: var(--white);
    border-color: var(--rust);
  }

  .btn-primary:hover {
    background: #5a0e0d;
    border-color: #5a0e0d;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(117, 19, 18, 0.3);
  }

  .btn-outline {
    background: transparent;
    color: var(--indigo);
    border-color: var(--indigo);
  }

  .btn-outline:hover {
    background: var(--indigo);
    color: var(--white);
    transform: translateY(-2px);
  }

  .btn-white {
    background: var(--white);
    color: var(--rust);
    border-color: var(--white);
  }

  .btn-white:hover {
    background: var(--off-white);
    transform: translateY(-2px);
  }

  .btn-outline-white {
    background: transparent;
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.6);
  }

  .btn-outline-white:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--white);
    transform: translateY(-2px);
  }

  /* ── Bottom CTA ──────────────────────────────── */
  .cap-cta {
    padding: calc(var(--space-xl) * 2) 0;
    background: linear-gradient(135deg, var(--indigo) 0%, #01141f 100%);
    text-align: center;
  }

  .cap-cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cap-cta-content h2 {
    color: var(--white);
    margin-bottom: var(--space-md);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .cap-cta-content p {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-xl);
    font-size: 1.1rem;
  }

  .cap-cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 768px) {
    .cap-hero-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .cap-hero-actions {
      flex-direction: row;
      align-items: center;
      width: 100%;
    }

    .cap-hero-actions .btn {
      flex: 1;
      text-align: center;
    }

    .contact-bar {
      gap: var(--space-md);
    }

    .contact-bar-item {
      font-size: 0.825rem;
    }

    .cap-grid {
      grid-template-columns: 1fr;
    }

    .cap-cta-buttons {
      flex-direction: column;
    }

    .cap-cta-buttons .btn {
      width: 100%;
    }
  }
</style>