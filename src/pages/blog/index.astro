---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = (
  await getCollection('blog', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts.filter(p => p.data.featured)[0];
const rest = allPosts.filter(p => p !== featured);

function postUrl(id: string) {
  return `/blog/${id.replace(/\.mdx?$/, '')}`;
}

const categories = [
  'All',
  'Government Contracting',
  'Nonprofit Strategy',
  'Web Modernization',
  'AI & Content Strategy',
  'Subcontracting',
];
---

<Layout
  title="Insights | Web Modernization, AI & Digital Strategy | Guiding Point Consulting"
  description="Strategy and resources for public sector prime contractors and mission-driven nonprofits navigating website modernization, AI content systems, and human-centered digital transformation."
>

  <style>
    :root {
      --indigo:    #32345a;
      --indigo-md: #44467a;
      --red:       #ac3430;
      --red-lt:    #c94540;
      --beige:     #f9eac5;
      --blush:     #f4e5e2;
      --white:     #fdfbfb;
      --charcoal:  #2c3e50;
      --mid:       #6b7a8d;
      --rule:      #e8ddd5;
    }

    /* ── Page Hero ── */
    .blog-hero { background: var(--indigo); color: white; padding: 72px 24px 56px; position: relative; overflow: hidden; }
    .blog-hero::before { content: ''; position: absolute; top: -60px; right: -60px; width: 380px; height: 380px; border-radius: 50%; border: 1px solid rgba(172,52,48,0.2); pointer-events: none; }
    .blog-hero::after  { content: ''; position: absolute; bottom: -80px; left: -40px; width: 260px; height: 260px; border-radius: 50%; border: 1px solid rgba(249,234,197,0.1); pointer-events: none; }
    .hero-inner { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; }
    .eyebrow { font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--beige); margin-bottom: 14px; opacity: 0.8; }
    .blog-hero h1 { font-family: 'Playfair Display', serif !important; font-size: clamp(2rem, 5vw, 3.4rem) !important; color: white !important; line-height: 1.15 !important; max-width: 680px; margin-bottom: 14px !important; margin-top: 0 !important; }
    .blog-hero p { font-size: 1.02rem; color: rgba(255,255,255,0.6); max-width: 520px; font-weight: 300; }

    /* ── Filter Bar ── */
    .filter-bar { background: var(--white); border-bottom: 1px solid var(--rule); position: sticky; top: 0; z-index: 40; }
    .filter-inner { max-width: 1100px; margin: 0 auto; padding: 0 16px; display: flex; flex-wrap: wrap; }
    .filter-btn {
      padding: 14px 16px;
      border: none;
      background: none !important;
      box-shadow: none !important;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--mid);
      cursor: pointer;
      white-space: nowrap;
      border-bottom: 2px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    .filter-btn:first-child {
      font-weight: 700;
      color: var(--indigo);
      padding-right: 20px;
      border-right: 1px solid var(--rule);
      margin-right: 4px;
    }
    .filter-btn:hover { color: var(--indigo); border-bottom-color: var(--rule); background: none !important; }
    .filter-btn.active { color: var(--indigo); border-bottom-color: var(--red); background: none !important; }

    /* ── Main ── */
    .blog-main { max-width: 1100px; margin: 0 auto; padding: 56px 24px 96px; }

    /* ── Featured ── */
    .featured-post { display: grid; grid-template-columns: 1fr 1fr; background: var(--white); border: 1px solid var(--rule); border-radius: 2px; overflow: hidden; margin-bottom: 64px; transition: box-shadow 0.25s; text-decoration: none; color: inherit; }
    .featured-post:hover { box-shadow: 0 12px 40px rgba(50,52,90,0.12); }
    .featured-image { background: var(--indigo); min-height: 360px; position: relative; overflow: hidden; }
    .featured-image img { width: 100%; height: 100%; object-fit: contain; background: var(--indigo); opacity: 1; }
    .featured-image-placeholder { width: 100%; height: 100%; min-height: 360px; background: linear-gradient(135deg, var(--indigo) 0%, var(--indigo-md) 100%); }
    .category-badge { position: absolute; top: 24px; left: 24px; background: var(--red); color: white; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; padding: 5px 12px; border-radius: 2px; }
    .featured-content { padding: 52px 48px; display: flex; flex-direction: column; justify-content: center; }
    .featured-label { font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red); margin-bottom: 20px; }
    .featured-content h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; line-height: 1.25; color: var(--indigo); margin-bottom: 16px; }
    .featured-content p { font-size: 0.95rem; color: var(--mid); line-height: 1.75; margin-bottom: 28px; }
    .post-meta { font-size: 0.8rem; color: var(--mid); display: flex; gap: 16px; align-items: center; margin-bottom: 28px; }
    .read-link { display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 600; color: var(--indigo); text-decoration: none; border-bottom: 1px solid var(--red); padding-bottom: 2px; }

    /* ── Grid ── */
    .section-label { font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mid); margin-bottom: 28px; padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
    .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px; }
    .post-card { background: var(--white); border: 1px solid var(--rule); border-radius: 2px; overflow: hidden; display: flex; flex-direction: column; transition: box-shadow 0.25s, transform 0.25s; }
    .post-card:hover { box-shadow: 0 8px 28px rgba(50,52,90,0.1); transform: translateY(-2px); }
    .card-image { height: 180px; position: relative; overflow: hidden; background: var(--indigo); }
    .card-image img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
    .card-image-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--indigo) 0%, var(--indigo-md) 100%); }
    .card-body { padding: 28px 28px 24px; flex: 1; display: flex; flex-direction: column; }
    .card-category { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
    .card-body h3 { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; line-height: 1.3; color: var(--indigo); margin-bottom: 10px; }
    .card-body p { font-size: 0.875rem; color: var(--mid); line-height: 1.7; flex: 1; margin-bottom: 20px; }
    .card-footer { border-top: 1px solid var(--rule); padding-top: 16px; display: flex; justify-content: space-between; align-items: center; }
    .card-date { font-size: 0.78rem; color: var(--mid); }
    .card-link { font-size: 0.8rem; font-weight: 600; color: var(--indigo); text-decoration: none; }
    .card-link:hover { color: var(--red); }

    /* ── LinkedIn CTA ── */
    .linkedin-cta { margin-top: 72px; background: var(--indigo); color: white; padding: 48px; border-radius: 2px; display: flex; justify-content: space-between; align-items: center; gap: 32px; }
    .linkedin-cta h3 { font-family: 'Playfair Display', serif; font-size: 1.4rem; margin-bottom: 8px; }
    .linkedin-cta p { font-size: 0.875rem; color: rgba(255,255,255,0.6); }
    .linkedin-btn { flex-shrink: 0; background: var(--red); color: white; font-family: inherit; font-weight: 700; font-size: 0.88rem; padding: 14px 28px; border-radius: 2px; text-decoration: none; white-space: nowrap; transition: background 0.2s; }
    .linkedin-btn:hover { background: var(--red-lt); }

    @media (max-width: 768px) {
      .featured-post { grid-template-columns: 1fr; }
      .featured-image { min-height: 220px; }
      .featured-image-placeholder { min-height: 220px; }
      .featured-content { padding: 32px 28px; }
      .linkedin-cta { flex-direction: column; text-align: center; }
      .filter-btn { padding: 12px 12px; font-size: 0.78rem; }
    }
  </style>

  <!-- Page Hero -->
  <section class="blog-hero">
    <div class="hero-inner">
      <p class="eyebrow">Insights &amp; Resources</p>
      <h1>Strategy for Those<br /><em>Doing the Real Work</em></h1>
      <p>Resources for government prime contractors and mission-driven nonprofits navigating digital modernization, subcontracting partnerships, and AI-powered growth.</p>
    </div>
  </section>

  <!-- Filter Bar -->
  <nav class="filter-bar" aria-label="Filter by category">
    <div class="filter-inner">
      {categories.map((cat, i) => (
        <button class={`filter-btn${i === 0 ? ' active' : ''}`} data-category={cat}>{cat}</button>
      ))}
    </div>
  </nav>

  <!-- Posts -->
  <main class="blog-main">

    {featured && (
      <a href={postUrl(featured.id)} class="featured-post" data-category={featured.data.category}>
        <div class="featured-image">
          {featured.data.coverImage
            ? <img src={featured.data.coverImage} alt={featured.data.coverAlt || featured.data.title} />
            : <div class="featured-image-placeholder" />
          }
          <span class="category-badge">{featured.data.category}</span>
        </div>
        <div class="featured-content">
          <p class="featured-label">✦ Featured Post</p>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <div class="post-meta">
            <span>{featured.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            <span>·</span>
            <span>{featured.data.author}</span>
          </div>
          <span class="read-link">Read Article →</span>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <>
        <p class="section-label">All Posts — {rest.length} Article{rest.length !== 1 ? 's' : ''}</p>
        <div class="post-grid">
          {rest.map(post => (
            <article class="post-card" data-category={post.data.category}>
              <div class="card-image">
                {post.data.coverImage
                  ? <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} />
                  : <div class="card-image-placeholder" />
                }
              </div>
              <div class="card-body">
                <p class="card-category">{post.data.category}</p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="card-footer">
                  <span class="card-date">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  <a href={postUrl(post.id)} class="card-link">Read →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    <div class="linkedin-cta">
      <div>
        <h3>Get These Insights in Your Inbox</h3>
        <p>Subscribe to the Guiding Point LinkedIn Newsletter — strategy for primes, subcontractors, and mission-based orgs, delivered biweekly.</p>
      </div>
      <a href="https://www.linkedin.com/in/zipporahbanyay/" target="_blank" rel="noopener noreferrer" class="linkedin-btn">
        Subscribe on LinkedIn →
      </a>
    </div>

  </main>

  <script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.featured-post, .post-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const selected = btn.dataset.category;
      cards.forEach(card => {
        card.style.display = (selected === 'All' || card.dataset.category === selected) ? '' : 'none';
      });
    });
  });
</script>

</Layout>